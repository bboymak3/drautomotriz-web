---
import { vehiculos, marcas, totalVehiculos } from '@/data/marcas';
import { waLink } from '@/data/config';

interface Props {
  comunaNombre?: string;
}

const { comunaNombre } = Astro.props;

// Mostrar todos los vehículos con foto (32)
const vehiculosConFoto = vehiculos.filter(v => v.imagen);

// Título dinámico según si viene de una comuna o no
const titulo = comunaNombre
  ? `Marcas y Modelos que Atendemos en ${comunaNombre}`
  : 'Marcas y Modelos que Atendemos';
---

<section class="py-16 relative overflow-hidden">
  <div class="absolute inset-0 bg-grid opacity-10"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-neon-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container-x relative">
    <div class="text-center mb-10">
      <span class="badge-neon mb-4">Vehículos que atendemos</span>
      <h2 class="text-2xl md:text-3xl font-display font-bold text-white mb-4">
        {titulo}
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto text-sm md:text-base">
        Atendemos <strong class="text-neon-400">{totalVehiculos} modelos reales</strong> de {marcas.length} marcas con servicio mecánico a domicilio. Cada vehículo tiene su propia landing con servicios específicos y fotografías reales.
      </p>
    </div>

    <!-- Grid de miniaturas de vehículos -->
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-2 md:gap-3">
      {vehiculosConFoto.map(v => {
        const prefix = v.marcaSlug + '-';
        const modeloSlug = v.slug.startsWith(prefix) ? v.slug.slice(prefix.length) : v.slug;
        return (
          <a
            href={`/vehiculos/${v.marcaSlug}/${modeloSlug}`}
            class="group relative aspect-square rounded-lg overflow-hidden border border-neon-500/20 hover:border-neon-500/60 transition-all"
            title={`${v.marca} ${v.modelo} - Ver servicios`}
          >
            <img
              src={v.imagen}
              alt={v.alt}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-dark-400/90 via-transparent to-transparent opacity-60 group-hover:opacity-90 transition-opacity"></div>
            <div class="absolute bottom-1 left-1 right-1 text-center">
              <div class="text-[8px] md:text-[10px] text-neon-400 uppercase tracking-wide font-semibold leading-tight truncate">
                {v.marca}
              </div>
              <div class="text-[9px] md:text-[11px] text-white font-bold leading-tight truncate">
                {v.modelo}
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Resumen de marcas -->
    <div class="mt-8 flex flex-wrap justify-center gap-2">
      {marcas.map(m => (
        <span class="badge-neon text-xs">
          {m.nombre} ({m.modelos.length})
        </span>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-8">
      <a href="/vehiculos/todos" class="btn-outline-neon text-sm">
        Ver todos los {totalVehiculos} vehículos
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
