---
// Banner mediano (60% ancho aprox) con la imagen revision-tecnica-sin-estres-02.png
// Se coloca antes del Texto SEO 1 en la index
// max-w-5xl = ~25% mas grande que max-w-3xl
---

<section class="py-8 md:py-12 relative overflow-hidden">
  <div class="absolute inset-0 bg-grid opacity-10"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[600px] bg-orange-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container-x relative">
    <!-- Banner responsivo: full-width en mobile, ~70% aprox en desktop -->
    <div class="relative max-w-6xl mx-auto w-full">
      <!-- Glow detrás -->
      <div class="absolute -inset-3 rounded-2xl bg-gradient-orange opacity-20 blur-2xl"></div>

      <!-- Imagen -->
      <div class="relative aspect-16/9 rounded-2xl overflow-hidden border-2 border-orange-500/40 shadow-orange-neon-lg">
        <img
          src="/imagen/banner/revision-tecnica-sin-estres-02.png"
          alt="Revisión Técnica Sin Estrés en Santiago - DRAUTOMOTRIZ retira tu auto y lo devuelve con el documento aprobado"
          class="w-full h-full object-cover"
          loading="lazy"
        />

        <!-- Degradado superior sutil -->
        <div class="absolute inset-x-0 top-0 h-12 md:h-16 bg-gradient-to-b from-dark-400/60 to-transparent"></div>

        <!-- Degradado inferior pronunciado -->
        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-dark-400/95 via-dark-400/60 to-transparent"></div>

        <!-- Texto inferior sobre imagen -->
        <div class="absolute bottom-3 left-3 right-3 md:bottom-5 md:left-5 md:right-5">
          <div class="text-xs md:text-sm text-orange-400 uppercase tracking-wider mb-1 font-semibold">Revisión Técnica Sin Estrés</div>
          <div class="text-white font-display font-bold text-sm md:text-lg lg:text-xl leading-tight">
            Retiramos tu auto · Trámite · Devolución con documento
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
