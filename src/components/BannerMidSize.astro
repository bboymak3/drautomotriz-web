---
// Banner mediano (50% ancho) con la imagen revision-tecnica-sin-estres-02.png
// Se coloca antes del Texto SEO 1 en la index
---

<section class="py-12 relative overflow-hidden">
  <div class="absolute inset-0 bg-grid opacity-10"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-orange-500/10 rounded-full blur-3xl"></div>

  <div class="container-x relative">
    <div class="max-w-3xl mx-auto">
      <!-- Banner al 50% del ancho, centrado -->
      <div class="relative">
        <!-- Glow detrás -->
        <div class="absolute -inset-3 rounded-2xl bg-gradient-orange opacity-20 blur-2xl"></div>

        <!-- Imagen -->
        <div class="relative aspect-16/9 rounded-2xl overflow-hidden border-2 border-orange-500/40 shadow-orange-neon-lg">
          <img
            src="/imagen/banner/revision-tecnica-sin-estres-02.png"
            alt="Revisión Técnica Sin Estrés en Santiago - DRAUTOMOTRIZ retira tu auto y lo devuelve con el documento aprobado"
            class="w-full h-full object-cover"
            loading="lazy"
          />

          <!-- Degradado superior sutil -->
          <div class="absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-dark-400/60 to-transparent"></div>

          <!-- Degradado inferior pronunciado -->
          <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-dark-400/95 via-dark-400/60 to-transparent"></div>

          <!-- Badge superior -->
          <div class="absolute top-3 left-3 px-3 py-1.5 bg-orange-500/95 backdrop-blur rounded-lg border border-orange-400 text-dark-500 text-xs font-bold uppercase tracking-wider shadow-orange-neon">
            ★ Servicio Estrella
          </div>

          <!-- Texto inferior sobre imagen -->
          <div class="absolute bottom-3 left-3 right-3">
            <div class="text-xs text-orange-400 uppercase tracking-wider mb-1 font-semibold">Revisión Técnica Sin Estrés</div>
            <div class="text-white font-display font-bold text-base md:text-lg leading-tight">
              Retiramos tu auto · Trámite · Devolución con documento
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
