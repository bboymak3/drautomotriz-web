---
import { comunas, zonas, getComunasByZona } from '@/data/comunas';
import { waLink } from '@/data/config';
import ComunaMap from '@/components/ComunaMap.astro';

const zonaColores: Record<string, string> = {
  'Norte': 'from-blue-500 to-cyan-500',
  'Oriente': 'from-neon-500 to-teal-500',
  'Sur': 'from-orange-500 to-amber-500',
  'Poniente': 'from-purple-500 to-pink-500',
};

const zonaColoresHex: Record<string, string> = {
  'Norte': '#3B82F6',
  'Oriente': '#00d4ff',
  'Sur': '#ff8a00',
  'Poniente': '#A855F7',
};
---

<section class="py-16 relative overflow-hidden">
  <div class="absolute inset-0 bg-grid opacity-10"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-neon-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container-x relative">
    <div class="text-center mb-10">
      <span class="badge-neon mb-4">Cobertura</span>
      <h2 class="text-3xl md:text-4xl font-display font-extrabold text-white mb-4">
        Comunas que <span class="text-transparent bg-clip-text bg-gradient-neon glow-text">Cubrimos en Santiago</span>
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto">
        Atendemos en {comunas.length} comunas de la Región Metropolitana. Selecciona tu comuna en la lista o haz click en el mapa para ver los servicios disponibles.
      </p>
    </div>

    <!-- Layout: lista de comunas (izquierda) + mapa (derecha) -->
    <div class="grid lg:grid-cols-2 gap-6">

      <!-- Columna izquierda: Lista de comunas por zona -->
      <div class="space-y-4">
        <!-- Buscador -->
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none z-10">
            <svg class="w-5 h-5 text-neon-500/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
          <input
            id="comuna-search-input"
            type="text"
            placeholder="Buscar comuna... (ej: Las Condes, Maipú)"
            autocomplete="off"
            class="w-full pl-12 pr-4 py-3 bg-dark-200 border-2 border-neon-500/20 rounded-xl text-white text-sm placeholder-gray-500 focus:outline-none focus:border-neon-500 focus:ring-1 focus:ring-neon-500/30 transition-all duration-300"
          />
        </div>

        <!-- Lista de comunas por zona (scrollable) -->
        <div class="bg-dark-200/50 rounded-xl border border-neon-500/20 max-h-[460px] overflow-y-auto p-4 space-y-4" id="comunas-lista-container">
          {zonas.map(zona => {
            const lista = getComunasByZona(zona);
            const colorHex = zonaColoresHex[zona] || '#00d4ff';
            return (
              <div data-zona={zona}>
                <div class="flex items-center gap-2 mb-2 sticky top-0 bg-dark-200/95 backdrop-blur py-1 z-10">
                  <div class="w-2 h-6 rounded" style={`background: ${colorHex}; box-shadow: 0 0 8px ${colorHex};`}></div>
                  <h4 class="font-display font-bold text-white text-sm">Zona {zona}</h4>
                  <span class="text-xs text-gray-500">({lista.length})</span>
                </div>
                <div class="grid grid-cols-2 gap-1.5">
                  {lista.map(c => (
                    <button
                      class="comuna-lista-btn px-2 py-1.5 rounded text-xs text-gray-300 bg-dark-100/50 border border-neon-500/10 hover:bg-neon-500 hover:text-dark-500 hover:border-neon-500 transition-all text-left"
                      data-comuna-nombre={c.nombre}
                      data-comuna-slug={c.slug}
                    >
                      {c.nombre}
                    </button>
                  ))}
                </div>
              </div>
            );
          })}
        </div>

        <!-- CTA -->
        <div class="text-center">
          <p class="text-xs text-gray-500 mb-2">¿No ves tu comuna? Probablemente también te atendemos.</p>
          <a href={waLink('Hola, ¿atienden en mi comuna de Santiago?')} target="_blank" rel="noopener" class="btn-whatsapp text-xs">
            Consultar cobertura
          </a>
        </div>
      </div>

      <!-- Columna derecha: Mapa interactivo -->
      <div>
        <ComunaMap />
      </div>

    </div>
  </div>
</section>

<!-- Modal eliminado: el mapa ahora está siempre visible -->

<script>
  // Buscador de comunas (filtra la lista)
  const searchInput = document.getElementById('comuna-search-input');
  const listaContainer = document.getElementById('comunas-lista-container');

  searchInput?.addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase().trim();
    const botones = document.querySelectorAll('.comuna-lista-btn');
    botones.forEach(btn => {
      const nombre = (btn.getAttribute('data-comuna-nombre') || '').toLowerCase();
      if (q === '' || nombre.includes(q)) {
        btn.style.display = '';
      } else {
        btn.style.display = 'none';
      }
    });
    // Ocultar zonas sin comunas visibles
    document.querySelectorAll('[data-zona]').forEach(zona => {
      const visibles = zona.querySelectorAll('.comuna-lista-btn:not([style*="display: none"])');
      zona.style.display = visibles.length > 0 ? '' : 'none';
    });
  });

  // Click en comuna de la lista: resaltar en mapa + ir a landing al segundo click
  let comunaSeleccionada = null;

  document.querySelectorAll('.comuna-lista-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-comuna-slug');
      const nombre = btn.getAttribute('data-comuna-nombre');

      if (comunaSeleccionada === slug) {
        // Segundo click: ir a la landing
        window.location.href = '/comunas/' + slug + '/';
      } else {
        // Primer click: resaltar en el mapa
        comunaSeleccionada = slug;
        // Actualizar visual de botones
        document.querySelectorAll('.comuna-lista-btn').forEach(b => {
          b.classList.remove('bg-neon-500', 'text-dark-500', 'border-neon-500');
          b.classList.add('bg-dark-100/50', 'text-gray-300', 'border-neon-500/10');
        });
        btn.classList.add('bg-neon-500', 'text-dark-500', 'border-neon-500');
        btn.classList.remove('bg-dark-100/50', 'text-gray-300', 'border-neon-500/10');

        // Resaltar marcador en el mapa
        if (window.resaltarComunaEnMapa) {
          window.resaltarComunaEnMapa(slug, nombre);
        }

        // Cambiar tooltip del botón
        btn.title = 'Click nuevamente para ir a la landing de ' + nombre;
      }
    });
  });
</script>
