---
import { config } from '@/data/config';
import { servicios } from '@/data/servicios';
import { comunas, zonas, getComunasByZona } from '@/data/comunas';
import { waLink } from '@/data/config';

const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios', children: servicios.map(s => ({ label: s.nombre, href: `/servicios/${s.slug}` })) },
  { label: 'Comunas', href: '/comunas', children: zonas.map(z => ({ label: `Zona ${z}`, href: `/comunas?zona=${z}`, children: getComunasByZona(z).map(c => ({ label: c.nombre, href: `/comunas/${c.slug}` })) })) },
  { label: 'Quiénes Somos', href: '/quienes-somos' },
  { label: 'Contacto', href: '/contacto' },
];
---

<header class="sticky top-0 z-50 bg-dark-300/95 backdrop-blur-md border-b border-neon-500/20">
  <div class="container-x">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="relative">
          <div class="absolute inset-0 bg-neon-500 blur-lg opacity-50 group-hover:opacity-80 transition-opacity"></div>
          <svg class="relative w-9 h-9 md:w-11 md:h-11" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="2" width="36" height="36" rx="8" stroke="#00d4ff" stroke-width="2" fill="#0a0a0a"/>
            <path d="M12 26 L20 12 L28 26 M15 22 L25 22" stroke="#00d4ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="20" cy="20" r="2" fill="#00d4ff"/>
          </svg>
        </div>
        <div class="flex flex-col leading-none">
          <span class="font-display font-bold text-lg md:text-xl text-white glow-text tracking-wider">DRAUTOMOTRIZ</span>
          <span class="text-[10px] md:text-xs text-neon-400 uppercase tracking-widest">Mecánico a Domicilio</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1">
        {navItems.map(item => (
          <div class="relative group">
            <a
              href={item.href}
              class="px-4 py-2 text-sm font-medium text-gray-300 hover:text-neon-400 transition-colors uppercase tracking-wide flex items-center gap-1"
            >
              {item.label}
              {item.children && (
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              )}
            </a>
            {item.children && (
              <div class="absolute top-full left-0 mt-1 w-72 bg-dark-200 border border-neon-500/20 rounded-lg shadow-neon opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pt-2 max-h-[70vh] overflow-y-auto">
                {item.children.map(child => (
                  <div class="relative group/sub">
                    <a
                      href={child.href}
                      class="block px-4 py-2.5 text-sm text-gray-300 hover:bg-neon-500/10 hover:text-neon-400 transition-colors border-b border-neon-500/5 last:border-0"
                    >
                      {child.label}
                    </a>
                    {child.children && (
                      <div class="absolute top-0 left-full ml-1 w-56 bg-dark-200 border border-neon-500/20 rounded-lg shadow-neon opacity-0 invisible group-hover/sub:opacity-100 group-hover/sub:visible transition-all duration-200 max-h-[60vh] overflow-y-auto">
                        {child.children.map(sub => (
                          <a href={sub.href} class="block px-4 py-2 text-xs text-gray-400 hover:bg-neon-500/10 hover:text-neon-400 transition-colors border-b border-neon-500/5 last:border-0">
                            {sub.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </nav>

      <!-- CTA WhatsApp Desktop -->
      <a
        href={waLink()}
        target="_blank"
        rel="noopener"
        class="hidden md:inline-flex btn-whatsapp text-sm"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        {config.whatsappNumero.replace(/(\d{2})(\d{1})(\d{4})(\d{4})/, '+$1 $2 $3 $4')}
      </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        aria-label="Abrir menú"
        class="lg:hidden p-2 text-neon-400 hover:bg-neon-500/10 rounded-lg transition-colors"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Nav -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-neon-500/20 bg-dark-300/95 backdrop-blur-md">
    <nav class="container-x py-4 space-y-2 max-h-[80vh] overflow-y-auto">
      {navItems.map(item => (
        <div class="space-y-1">
          <a
            href={item.href}
            class="block px-3 py-2 text-sm font-medium text-gray-200 hover:bg-neon-500/10 hover:text-neon-400 rounded transition-colors uppercase"
          >
            {item.label}
          </a>
          {item.children && (
            <div class="pl-4 space-y-1 border-l border-neon-500/20 ml-3">
              {item.children.map(child => (
                <div class="space-y-1">
                  <a href={child.href} class="block px-3 py-1.5 text-xs text-gray-400 hover:text-neon-400 transition-colors">
                    {child.label}
                  </a>
                  {child.children && (
                    <div class="pl-3 space-y-1 border-l border-neon-500/10 ml-2">
                      {child.children.map(sub => (
                        <a href={sub.href} class="block px-3 py-1 text-[11px] text-gray-500 hover:text-neon-400 transition-colors">
                          {sub.label}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}
        </div>
      ))}
      <a href={waLink()} target="_blank" rel="noopener" class="btn-whatsapp w-full mt-4">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
  // Cerrar al hacer click fuera
  document.addEventListener('click', (e) => {
    if (!btn?.contains(e.target as Node) && !menu?.contains(e.target as Node)) {
      menu?.classList.add('hidden');
    }
  });
</script>
