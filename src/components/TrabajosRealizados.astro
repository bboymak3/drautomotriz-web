---
// ============================================================
// Publica las fichas de trabajos realizados (src/data/trabajos.ts).
// - modo "completo": cada ficha como sección grande (home, landing de vehículo)
// - modo "compacto": grilla de tarjetas con título de sección (galería, servicios)
// Filtros opcionales: servicio (slug) o vehiculo (slug).
// Al agregar una ficha nueva: importarla aquí y sumarla a `componentes`.
// ============================================================
import { trabajos, getTrabajosPorServicio, getTrabajosPorVehiculo } from '@/data/trabajos';
import TrabajoChevroletNKR from '@/components/TrabajoChevroletNKR.astro';
import TrabajoNissanTiida from '@/components/TrabajoNissanTiida.astro';
import TrabajoVolkswagenGolf from '@/components/TrabajoVolkswagenGolf.astro';
import TrabajoChevroletOnix from '@/components/TrabajoChevroletOnix.astro';
import TrabajoChevroletCorsa from '@/components/TrabajoChevroletCorsa.astro';
import TrabajoToyota4Runner from '@/components/TrabajoToyota4Runner.astro';
import TrabajoNissanMarch from '@/components/TrabajoNissanMarch.astro';
import TrabajoSuzukiBaleno from '@/components/TrabajoSuzukiBaleno.astro';
import TrabajoMGZS from '@/components/TrabajoMGZS.astro';
import TrabajoHinoXZU from '@/components/TrabajoHinoXZU.astro';
import TrabajoCitroenC3 from '@/components/TrabajoCitroenC3.astro';
import TrabajoChevroletTracker from '@/components/TrabajoChevroletTracker.astro';
import TrabajoVolkswagenBora from '@/components/TrabajoVolkswagenBora.astro';

const componentes: Record<string, any> = {
  'chevrolet-nkr-512': TrabajoChevroletNKR,
  'nissan-tiida': TrabajoNissanTiida,
  'volkswagen-golf': TrabajoVolkswagenGolf,
  'chevrolet-onix': TrabajoChevroletOnix,
  'chevrolet-corsa': TrabajoChevroletCorsa,
  'toyota-4runner': TrabajoToyota4Runner,
  'nissan-march': TrabajoNissanMarch,
  'suzuki-baleno': TrabajoSuzukiBaleno,
  'mg-zs': TrabajoMGZS,
  'hino-xzu-425l': TrabajoHinoXZU,
  'citroen-c3': TrabajoCitroenC3,
  'chevrolet-tracker': TrabajoChevroletTracker,
  'volkswagen-bora': TrabajoVolkswagenBora,
};

interface Props {
  modo?: 'completo' | 'compacto';
  servicio?: string;
  vehiculo?: string;
  titulo?: string;
  subtitulo?: string;
  embebido?: boolean; // compacto sin <section>/contenedor propio (dentro de otra sección)
}

const { modo = 'completo', servicio, vehiculo, titulo = 'Trabajos realizados', subtitulo, embebido = false } = Astro.props;

const lista = (servicio ? getTrabajosPorServicio(servicio) : vehiculo ? getTrabajosPorVehiculo(vehiculo) : trabajos)
  .filter(t => componentes[t.id]);
---

{lista.length > 0 && (modo === 'completo' ? (
  lista.map(t => {
    const Ficha = componentes[t.id];
    return <Ficha />;
  })
) : (
  <section class={embebido ? 'mb-14' : 'py-12 md:py-16 relative overflow-hidden'} aria-label={titulo}>
    <div class={embebido ? '' : 'container-x relative'}>
      <div class="text-center mb-8">
        <span class="badge-neon mb-3">⚙️ Trabajos Realizados</span>
        <h2 class="text-2xl md:text-3xl font-display font-bold text-white mb-3">{titulo}</h2>
        {subtitulo && <p class="text-gray-400 max-w-2xl mx-auto text-sm md:text-base">{subtitulo}</p>}
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 md:gap-6 max-w-6xl mx-auto">
        {lista.map(t => {
          const Ficha = componentes[t.id];
          return <Ficha compacto />;
        })}
      </div>
    </div>
  </section>
))}
