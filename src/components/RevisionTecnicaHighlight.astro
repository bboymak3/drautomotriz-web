---
import { getServiciosDestacados } from '@/data/servicios';
import { waLink } from '@/data/config';

const destacados = getServiciosDestacados();
const revisionTecnica = destacados[0];

if (!revisionTecnica) {
  // No-op si no hay servicio destacado
  return null;
}
---

<section class="py-16 relative overflow-hidden">
  <!-- Glow naranja de fondo (responsive) -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[400px] md:w-[800px] md:h-[600px] bg-orange-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container-x relative">
    <div class="max-w-5xl mx-auto">
      <!-- Contenedor con borde naranja neón -->
      <div class="relative card-orange p-8 md:p-12">

        <!-- Esquina decorativa -->
        <div class="absolute top-0 right-0 -mt-1 -mr-1 px-4 py-1 bg-orange-500 text-dark-500 text-xs font-bold uppercase tracking-wider rounded-bl-lg rounded-tr-xl shadow-orange-neon">
          ★ Servicio Estrella
        </div>

        <div class="grid lg:grid-cols-2 gap-8 items-center">
          <!-- Left: Contenido -->
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="w-16 h-16 rounded-lg bg-orange-500/10 border-2 border-orange-500 flex items-center justify-center text-4xl shadow-orange-neon animate-pulse-orange">
                {revisionTecnica.icono}
              </div>
              <span class="badge-orange">{revisionTecnica.categoria}</span>
            </div>

            <h2 class="text-3xl md:text-4xl font-display font-extrabold text-white mb-4 leading-tight">
              <span class="text-orange-400 glow-text-orange">{revisionTecnica.nombre}</span>
            </h2>

            <p class="text-lg text-gray-300 mb-6 leading-relaxed">
              {revisionTecnica.tagline}
            </p>

            <!-- Proceso en 3 pasos -->
            <div class="space-y-3 mb-8">
              <div class="flex items-start gap-3 p-3 rounded-lg bg-orange-500/5 border border-orange-500/20">
                <div class="w-8 h-8 rounded-full bg-orange-500 text-dark-500 font-bold flex items-center justify-center text-sm shrink-0">1</div>
                <div>
                  <div class="text-white font-semibold text-sm">Se retira el auto</div>
                  <div class="text-xs text-gray-400">Vamos a buscar tu vehículo a casa, oficina o estacionamiento donde tú elijas.</div>
                </div>
              </div>
              <div class="flex items-start gap-3 p-3 rounded-lg bg-orange-500/5 border border-orange-500/20">
                <div class="w-8 h-8 rounded-full bg-orange-500 text-dark-500 font-bold flex items-center justify-center text-sm shrink-0">2</div>
                <div>
                  <div class="text-white font-semibold text-sm">Se lleva a revisión técnica</div>
                  <div class="text-xs text-gray-400">Trámite obligatorio en Chile. Sin él, tu auto no puede circular legalmente.</div>
                </div>
              </div>
              <div class="flex items-start gap-3 p-3 rounded-lg bg-orange-500/5 border border-orange-500/20">
                <div class="w-8 h-8 rounded-full bg-orange-500 text-dark-500 font-bold flex items-center justify-center text-sm shrink-0">3</div>
                <div>
                  <div class="text-white font-semibold text-sm">Se devuelve el auto con documento aprobado</div>
                  <div class="text-xs text-gray-400">Si el auto está en condiciones, recibes el certificado aprobado al devolverlo.</div>
                </div>
              </div>
            </div>

            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href={`/servicios/${revisionTecnica.slug}`}
                class="btn-orange"
              >
                Ver detalles del servicio
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
              <a
                href={waLink(`Hola, necesito el servicio de ${revisionTecnica.nombre}`)}
                target="_blank"
                rel="noopener"
                class="btn-whatsapp"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                Agendar ahora
              </a>
            </div>
          </div>

          <!-- Right: Visual / stats -->
          <div class="relative">
            <!-- Stats card -->
            <div class="card-orange p-6 mb-4">
              <div class="grid grid-cols-2 gap-4">
                <div class="text-center">
                  <div class="text-3xl font-display font-bold text-orange-400 glow-text-orange">3-5h</div>
                  <div class="text-xs text-gray-400 uppercase tracking-wide mt-1">Ahorro de tiempo</div>
                </div>
                <div class="text-center">
                  <div class="text-3xl font-display font-bold text-orange-400 glow-text-orange">100%</div>
                  <div class="text-xs text-gray-400 uppercase tracking-wide mt-1">Trámite garantizado</div>
                </div>
                <div class="text-center">
                  <div class="text-3xl font-display font-bold text-orange-400 glow-text-orange">24/7</div>
                  <div class="text-xs text-gray-400 uppercase tracking-wide mt-1">WhatsApp en tiempo real</div>
                </div>
                <div class="text-center">
                  <div class="text-3xl font-display font-bold text-orange-400 glow-text-orange">40+</div>
                  <div class="text-xs text-gray-400 uppercase tracking-wide mt-1">Comunas RM</div>
                </div>
              </div>
            </div>

            <!-- Beneficios -->
            <div class="card-orange p-6">
              <h3 class="text-sm font-display font-bold text-orange-400 uppercase tracking-wider mb-3">¿Por qué elegirnos?</h3>
              <ul class="space-y-2 text-sm text-gray-300">
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-orange-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span>Cero filas, cero pérdida de tiempo</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-orange-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span>Conductor asegurado</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-orange-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span>Monitoreo en tiempo real</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-orange-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span>Garantía: si no aprueba, no pagas</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Divider naranja -->
        <div class="mt-8 h-px w-full bg-gradient-to-r from-transparent via-orange-500 to-transparent"></div>

        <!-- Footer de la sección -->
        <div class="mt-6 flex flex-col md:flex-row items-center justify-between gap-4">
          <p class="text-sm text-gray-400 text-center md:text-left">
            <strong class="text-orange-400">¿Sabías que?</strong> Circular sin revisión técnica en Chile puede resultar en multas de hasta 1 UTM y retención del vehículo.
          </p>
          <a
            href={`/servicios/${revisionTecnica.slug}`}
            class="btn-outline-orange text-sm whitespace-nowrap"
          >
            Saber más →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
