---
import { comunas } from '@/data/comunas';
import { config, waLink } from '@/data/config';
---

<section id="cotizacion" class="py-20 relative overflow-hidden">
  <div class="absolute inset-0 bg-grid opacity-20"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-neon-500/5 rounded-full blur-3xl"></div>

  <div class="container-x relative">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <span class="badge-neon mb-4">Cotización Rápida</span>
        <h2 class="section-title">Solicita tu Cotización Gratis</h2>
        <p class="section-subtitle">
          Completa el formulario y recibe una cotización por WhatsApp en minutos. Tu información se guarda en nuestra base de datos para un mejor seguimiento.
        </p>
      </div>

      <form id="quote-form" class="card-neon space-y-5">
        <!-- Nombre -->
        <div>
          <label for="nombre" class="block text-sm font-medium text-gray-300 mb-2">
            Nombre <span class="text-neon-400">*</span>
          </label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            required
            placeholder="Tu nombre completo"
            class="input-neon"
          />
        </div>

        <!-- Teléfono + Comuna -->
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label for="telefono" class="block text-sm font-medium text-gray-300 mb-2">
              Teléfono <span class="text-neon-400">*</span>
            </label>
            <input
              type="tel"
              id="telefono"
              name="telefono"
              required
              placeholder="+56 9 XXXX XXXX"
              class="input-neon"
            />
          </div>
          <div>
            <label for="comuna" class="block text-sm font-medium text-gray-300 mb-2">
              Comuna <span class="text-neon-400">*</span>
            </label>
            <select id="comuna" name="comuna" required class="input-neon">
              <option value="">Selecciona tu comuna</option>
              {comunas.map(c => (
                <option value={c.nombre}>{c.nombre}</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Vehículo -->
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label for="marca" class="block text-sm font-medium text-gray-300 mb-2">
              Marca del vehículo
            </label>
            <input
              type="text"
              id="marca"
              name="marca"
              placeholder="Ej: Toyota, Hyundai, Mazda"
              class="input-neon"
            />
          </div>
          <div>
            <label for="modelo" class="block text-sm font-medium text-gray-300 mb-2">
              Modelo / Año
            </label>
            <input
              type="text"
              id="modelo"
              name="modelo"
              placeholder="Ej: Corolla 2018"
              class="input-neon"
            />
          </div>
        </div>

        <!-- Servicio -->
        <div>
          <label for="servicio" class="block text-sm font-medium text-gray-300 mb-2">
            Servicio de interés <span class="text-neon-400">*</span>
          </label>
          <select id="servicio" name="servicio" required class="input-neon">
            <option value="">Selecciona un servicio</option>
            <option value="Mecánica General a Domicilio">Mecánica General a Domicilio</option>
            <option value="Escáner y Diagnóstico Computarizado">Escáner y Diagnóstico Computarizado</option>
            <option value="Mantención Preventiva y Afinamiento">Mantención Preventiva y Afinamiento</option>
            <option value="Servicio de Frenos a Domicilio">Servicio de Frenos a Domicilio</option>
            <option value="Revisión y Cambio de Batería">Revisión y Cambio de Batería</option>
            <option value="Suspensión y Tren Delantero">Suspensión y Tren Delantero</option>
            <option value="Sistema de Refrigeración">Sistema de Refrigeración</option>
            <option value="Inyección Electrónica y Limpieza">Inyección Electrónica y Limpieza</option>
            <option value="Auxilio Mecánico 24/7">Auxilio Mecánico 24/7 y Urgencias</option>
            <option value="Correa / Cadena de Distribución">Correa / Cadena de Distribución</option>
            <option value="Otro">Otro / No estoy seguro</option>
          </select>
        </div>

        <!-- Detalle de la falla -->
        <div>
          <label for="mensaje" class="block text-sm font-medium text-gray-300 mb-2">
            Detalla tu falla o consulta <span class="text-neon-400">*</span>
          </label>
          <textarea
            id="mensaje"
            name="mensaje"
            required
            rows="4"
            placeholder="Ej: El auto no arranca, hace ruido raro al frenar, se encendió la luz de Check Engine, etc."
            class="input-neon resize-none"
          ></textarea>
        </div>

        <!-- Fecha preferida -->
        <div>
          <label for="fecha" class="block text-sm font-medium text-gray-300 mb-2">
            Fecha preferida de atención
          </label>
          <input
            type="date"
            id="fecha"
            name="fecha"
            class="input-neon"
          />
        </div>

        <!-- Consentimiento -->
        <div class="flex items-start gap-3">
          <input
            type="checkbox"
            id="consentimiento"
            name="consentimiento"
            required
            class="mt-1 w-4 h-4 rounded border-neon-500/30 bg-dark-100 text-neon-500 focus:ring-neon-500/30"
          />
          <label for="consentimiento" class="text-xs text-gray-400">
            Acepto que mis datos sean almacenados para procesar mi solicitud de cotización, según las
            <a href="/politicas-de-privacidad" class="text-neon-400 hover:underline">Políticas de Privacidad</a>.
          </label>
        </div>

        <!-- Submit -->
        <div class="flex flex-col sm:flex-row gap-3">
          <button type="submit" class="btn-neon flex-1">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Enviar y abrir WhatsApp
          </button>
          <a href={waLink()} target="_blank" rel="noopener" class="btn-whatsapp flex-1">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            WhatsApp directo
          </a>
        </div>

        <p class="text-xs text-gray-500 text-center">
          Al enviar el formulario, tu información se guardará en nuestra base de datos y se abrirá WhatsApp con el mensaje pre-armado para que confirmes el envío.
        </p>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ whatsappNumero: config.whatsappNumero }}>
  const form = document.getElementById('quote-form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    // Validar consentimiento
    if (!data.consentimiento) {
      alert('Debes aceptar las políticas de privacidad para continuar.');
      return;
    }

    // Enviar a Cloudflare D1 (si está configurado) - fail silently si no
    try {
      await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
    } catch (err) {
      console.warn('No se pudo guardar en D1, pero el WhatsApp funcionará igual:', err);
    }

    // Armar mensaje de WhatsApp
    const mensaje = `*NUEVA COTIZACIÓN - DRAUTOMOTRIZ*%0A%0A` +
      `*Nombre:* ${data.nombre}%0A` +
      `*Teléfono:* ${data.telefono}%0A` +
      `*Comuna:* ${data.comuna}%0A` +
      `*Vehículo:* ${data.marca || 'No especificado'} ${data.modelo || ''}%0A` +
      `*Servicio:* ${data.servicio}%0A` +
      (data.fecha ? `*Fecha preferida:* ${data.fecha}%0A` : '') +
      `%0A*Detalle:*%0A${data.mensaje}`;

    // Abrir WhatsApp
    window.open(`https://wa.me/${whatsappNumero}?text=${encodeURIComponent(mensaje).replace(/%2520/g, '%20')}`, '_blank');

    // Resetear form
    form.reset();
    alert('¡Cotización enviada! Te redirigimos a WhatsApp para confirmar.');
  });
</script>
