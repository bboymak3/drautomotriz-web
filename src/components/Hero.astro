---
import { config, waLink } from '@/data/config';
import { servicios } from '@/data/servicios';
import { marcas, totalVehiculos } from '@/data/marcas';
---

<section class="relative overflow-hidden pt-8 pb-16 md:pt-12 md:pb-24">
  <!-- Grid background -->
  <div class="absolute inset-0 bg-grid opacity-30"></div>

  <!-- Glow orbs decorativos -->
  <div class="absolute top-20 -left-20 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 -right-20 w-96 h-96 bg-orange-500/10 rounded-full blur-3xl"></div>

  <div class="container-x relative">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">

      <!-- LEFT: Texto -->
      <div class="text-center lg:text-left order-2 lg:order-1">
        <!-- Badge de disponibilidad -->
        <div class="inline-flex items-center gap-2 badge-neon mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-neon-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-neon-500"></span>
          </span>
          Disponible 24/7 en Santiago · 40+ comunas
        </div>

        <!-- H1 -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-white mb-6 leading-tight text-balance">
          <span class="block">Mecánico a Domicilio</span>
          <span class="block text-transparent bg-clip-text bg-gradient-neon glow-text">en Santiago, Chile</span>
        </h1>

        <!-- Párrafo principal -->
        <p class="text-lg md:text-xl text-gray-300 mb-6 max-w-xl mx-auto lg:mx-0 leading-relaxed">
          <strong class="text-white">DRAUTOMOTRIZ</strong> lleva el taller mecánico directamente a tu casa u oficina. Diagnóstico computarizado, mantención preventiva, frenos, suspensión, batería, revisión técnica sin estrés y auxilio mecánico 24/7 en toda la Región Metropolitana.
        </p>

        <!-- Párrafo secundario -->
        <p class="text-base md:text-lg text-gray-400 mb-8 max-w-xl mx-auto lg:mx-0">
          Atendemos <strong class="text-neon-400">modelos reales</strong> de {marcas.length} marcas distintas con mecánicos certificados, repuestos OEM y garantía escrita. El mecánico llega a ti en <strong class="text-neon-400">45-60 minutos</strong>.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-10">
          <a href={waLink()} target="_blank" rel="noopener" class="btn-whatsapp text-base md:text-lg animate-pulse-neon">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Agenda por WhatsApp
          </a>
          <a href="#servicios" class="btn-outline-neon text-base md:text-lg">
            Ver {servicios.length} Servicios
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 lg:gap-6 max-w-xl mx-auto lg:mx-0">
          <div>
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{config.stats.clientes}</div>
            <div class="text-xs text-gray-500 uppercase tracking-wide">Clientes</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{config.stats.cobertura}</div>
            <div class="text-xs text-gray-500 uppercase tracking-wide">Comunas RM</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{config.stats.experiencia}</div>
            <div class="text-xs text-gray-500 uppercase tracking-wide">Experiencia</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{config.stats.servicios}</div>
            <div class="text-xs text-gray-500 uppercase tracking-wide">Servicios</div>
          </div>
        </div>
      </div>

      <!-- RIGHT: Imagen del vehículo de la empresa -->
      <div class="relative order-1 lg:order-2">
        <div class="relative max-w-lg mx-auto">
          <!-- Glow ring -->
          <div class="absolute -inset-4 rounded-2xl bg-gradient-neon opacity-20 blur-2xl"></div>

          <!-- Imagen principal -->
          <div class="relative aspect-square rounded-2xl overflow-hidden border-2 border-neon-500/40 shadow-neon-lg">
            <img
              src="/imagen/banner/vehiculo-empresa-drautomotriz.webp"
              alt="Vehículo de transporte de la empresa DRAUTOMOTRIZ - Mecánico a domicilio en Santiago con servicio móvil profesional"
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
            <!-- Overlay gradiente sutil -->
            <div class="absolute inset-0 bg-gradient-to-t from-dark-400/40 via-transparent to-transparent"></div>

            <!-- Badge flotante -->
            <div class="absolute top-4 left-4 px-3 py-1.5 bg-neon-500/90 backdrop-blur rounded-lg border border-neon-400 text-dark-500 text-xs font-bold uppercase tracking-wider shadow-neon">
              🚐 Servicio Móvil
            </div>

            <!-- Texto inferior -->
            <div class="absolute bottom-4 left-4 right-4">
              <div class="text-xs text-neon-400 uppercase tracking-wider mb-1 font-semibold">DRAUTOMOTRIZ</div>
              <div class="text-white font-display font-bold text-lg leading-tight">Mecánico a Domicilio en Santiago</div>
            </div>
          </div>

          <!-- Floating badges (solo desktop para evitar overflow mobile) -->
          <div class="hidden md:block absolute top-8 -right-4 card-neon p-3 animate-float" style="animation-delay: 0s;">
            <div class="flex items-center gap-2">
              <span class="text-2xl">🔧</span>
              <div>
                <div class="text-xs text-gray-400">Diagnóstico</div>
                <div class="text-sm font-bold text-neon-400">Computarizado</div>
              </div>
            </div>
          </div>
          <div class="hidden md:block absolute bottom-12 -left-4 card-neon p-3 animate-float" style="animation-delay: 1s;">
            <div class="flex items-center gap-2">
              <span class="text-2xl">⚡</span>
              <div>
                <div class="text-xs text-gray-400">Respuesta</div>
                <div class="text-sm font-bold text-neon-400">45-60 min</div>
              </div>
            </div>
          </div>
          <div class="hidden lg:block absolute top-1/2 -right-8 card-neon p-3 animate-float" style="animation-delay: 2s;">
            <div class="flex items-center gap-2">
              <span class="text-2xl">🛡️</span>
              <div>
                <div class="text-xs text-gray-400">Garantía</div>
                <div class="text-sm font-bold text-neon-400">3-12 meses</div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
