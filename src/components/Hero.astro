---
import { config, waLink } from '@/data/config';
import { servicios } from '@/data/servicios';
import { marcas, totalVehiculos } from '@/data/marcas';
---

<!-- HERO FULL-WIDTH CON BANNER -->
<section class="relative w-full min-h-[85vh] md:min-h-[90vh] flex items-end overflow-hidden">
  <!-- Imagen de fondo full-width -->
  <div class="absolute inset-0 z-0">
    <img
      src="/imagen/banner/revision-tecnica-sin-estres-02.png"
      alt="Mecánico a Domicilio en Santiago - DRAUTOMOTRIZ servicio automotriz a domicilio en toda la Región Metropolitana"
      class="w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <!-- Degradado superior (de oscuro a transparente) -->
  <div class="absolute inset-x-0 top-0 h-32 md:h-48 bg-gradient-to-b from-dark-400 via-dark-400/70 to-transparent z-10 pointer-events-none"></div>

  <!-- Degradado inferior (de transparente a oscuro) - más pronunciado para legibilidad del texto -->
  <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-dark-400 via-dark-400/85 to-transparent z-10 pointer-events-none"></div>

  <!-- Glow orbs decorativos -->
  <div class="absolute top-1/4 -left-20 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl z-10 pointer-events-none"></div>
  <div class="absolute bottom-1/4 -right-20 w-96 h-96 bg-orange-500/10 rounded-full blur-3xl z-10 pointer-events-none"></div>

  <!-- Contenido superpuesto (alineado al fondo) -->
  <div class="relative z-20 w-full">
    <div class="container-x py-12 md:py-16">
      <div class="max-w-4xl">
        <!-- Badge de disponibilidad -->
        <div class="inline-flex items-center gap-2 badge-neon mb-6 backdrop-blur-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-neon-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-neon-500"></span>
          </span>
          Disponible 24/7 en Santiago · 40+ comunas
        </div>

        <!-- H1 -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-display font-extrabold text-white mb-6 leading-tight text-balance">
          <span class="block">Mecánico a Domicilio</span>
          <span class="block text-transparent bg-clip-text bg-gradient-neon glow-text">en Santiago, Chile</span>
        </h1>

        <!-- Párrafo principal -->
        <p class="text-lg md:text-xl lg:text-2xl text-gray-100 mb-6 max-w-2xl leading-relaxed">
          <strong class="text-white">DRAUTOMOTRIZ</strong> lleva el taller mecánico directamente a tu casa u oficina. Diagnóstico computarizado, mantención preventiva, frenos, suspensión, batería, revisión técnica sin estrés y auxilio mecánico 24/7 en toda la Región Metropolitana.
        </p>

        <!-- Párrafo secundario -->
        <p class="text-base md:text-lg text-gray-300 mb-8 max-w-2xl">
          Atendemos <strong class="text-neon-400">{totalVehiculos} modelos reales</strong> de {marcas.length} marcas distintas con mecánicos certificados, repuestos OEM y garantía escrita. El mecánico llega a ti en <strong class="text-neon-400">45-60 minutos</strong>.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 mb-10">
          <a href={waLink()} target="_blank" rel="noopener" class="btn-whatsapp text-base md:text-lg animate-pulse-neon">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Agenda por WhatsApp
          </a>
          <a href="#servicios" class="btn-outline-neon text-base md:text-lg backdrop-blur-sm">
            Ver {servicios.length} Servicios
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 lg:gap-6 max-w-2xl backdrop-blur-sm bg-dark-300/30 p-4 rounded-xl border border-neon-500/20">
          <div>
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{config.stats.clientes}</div>
            <div class="text-xs text-gray-300 uppercase tracking-wide">Clientes</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{config.stats.cobertura}</div>
            <div class="text-xs text-gray-300 uppercase tracking-wide">Comunas RM</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{config.stats.experiencia}</div>
            <div class="text-xs text-gray-300 uppercase tracking-wide">Experiencia</div>
          </div>
          <div>
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{config.stats.servicios}</div>
            <div class="text-xs text-gray-300 uppercase tracking-wide">Servicios</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
