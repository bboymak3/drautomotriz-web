---
import { config, waLink } from '@/data/config';
---

<section class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-32">
  <!-- Grid background -->
  <div class="absolute inset-0 bg-grid opacity-30"></div>

  <!-- Glow orbs -->
  <div class="absolute top-20 -left-20 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 -right-20 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl"></div>

  <div class="container-x relative">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Content -->
      <div class="text-center lg:text-left">
        <div class="inline-flex items-center gap-2 badge-neon mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-neon-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-neon-500"></span>
          </span>
          Disponible 24/7 en Santiago
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-extrabold text-white mb-6 leading-tight text-balance">
          <span class="block">Mecánico a Domicilio</span>
          <span class="block text-transparent bg-clip-text bg-gradient-neon glow-text">en Santiago</span>
        </h1>

        <p class="text-lg md:text-xl text-gray-400 mb-8 max-w-xl mx-auto lg:mx-0">
          Vamos a tu <span class="text-neon-400 font-semibold">casa o trabajo</span> con diagnóstico computarizado, mantención, frenos, batería, suspensión y auxilio mecánico 24/7. Sin grúa, sin taller, sin pérdida de tiempo.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-10">
          <a href={waLink()} target="_blank" rel="noopener" class="btn-whatsapp text-base animate-pulse-neon">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Agenda por WhatsApp
          </a>
          <a href="/servicios" class="btn-outline-neon text-base">
            Ver Servicios
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 lg:gap-6">
          <div class="text-center lg:text-left">
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{config.stats.clientes}</div>
            <div class="text-xs text-gray-500 uppercase tracking-wide">Clientes</div>
          </div>
          <div class="text-center lg:text-left">
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{config.stats.cobertura}</div>
            <div class="text-xs text-gray-500 uppercase tracking-wide">Comunas</div>
          </div>
          <div class="text-center lg:text-left">
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{config.stats.experiencia}</div>
            <div class="text-xs text-gray-500 uppercase tracking-wide">Experiencia</div>
          </div>
          <div class="text-center lg:text-left">
            <div class="text-2xl md:text-3xl font-display font-bold text-neon-400 glow-text">{config.stats.rating}</div>
            <div class="text-xs text-gray-500 uppercase tracking-wide">Rating</div>
          </div>
        </div>
      </div>

      <!-- Right: Visual -->
      <div class="relative hidden lg:block">
        <div class="relative aspect-square max-w-lg mx-auto">
          <!-- Glow ring -->
          <div class="absolute inset-0 rounded-full border-2 border-neon-500/30 animate-pulse-neon"></div>
          <div class="absolute inset-8 rounded-full border border-neon-500/20"></div>
          <div class="absolute inset-16 rounded-full border border-neon-500/10"></div>

          <!-- Center logo / icon -->
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="relative">
              <div class="absolute inset-0 bg-neon-500 blur-3xl opacity-30 animate-glow"></div>
              <svg class="relative w-64 h-64" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Outer hex -->
                <polygon points="100,10 175,55 175,145 100,190 25,145 25,55" stroke="#00d4ff" stroke-width="2" fill="none" opacity="0.5"/>
                <!-- Inner hex -->
                <polygon points="100,30 155,65 155,135 100,170 45,135 45,65" stroke="#00d4ff" stroke-width="1.5" fill="none" opacity="0.3"/>

                <!-- Car silhouette -->
                <g transform="translate(50, 80)">
                  <path d="M0,30 L10,15 L80,15 L95,30 L100,30 L100,45 L0,45 Z" fill="#00d4ff" opacity="0.9"/>
                  <path d="M15,18 L25,5 L65,5 L75,18" stroke="#00d4ff" stroke-width="2" fill="none"/>
                  <circle cx="25" cy="48" r="8" fill="#0a0a0a" stroke="#00d4ff" stroke-width="2"/>
                  <circle cx="75" cy="48" r="8" fill="#0a0a0a" stroke="#00d4ff" stroke-width="2"/>
                  <circle cx="25" cy="48" r="3" fill="#00d4ff"/>
                  <circle cx="75" cy="48" r="3" fill="#00d4ff"/>
                </g>

                <!-- Tool icons around -->
                <g opacity="0.7">
                  <circle cx="100" cy="20" r="6" fill="#00d4ff"/>
                  <circle cx="170" cy="60" r="4" fill="#00d4ff"/>
                  <circle cx="180" cy="120" r="5" fill="#00d4ff"/>
                  <circle cx="150" cy="170" r="4" fill="#00d4ff"/>
                  <circle cx="50" cy="170" r="5" fill="#00d4ff"/>
                  <circle cx="20" cy="120" r="4" fill="#00d4ff"/>
                  <circle cx="30" cy="60" r="5" fill="#00d4ff"/>
                </g>

                <!-- Center pulse -->
                <circle cx="100" cy="100" r="3" fill="#00d4ff">
                  <animate attributeName="r" values="3;8;3" dur="2s" repeatCount="indefinite"/>
                  <animate attributeName="opacity" values="1;0.3;1" dur="2s" repeatCount="indefinite"/>
                </circle>
              </svg>
            </div>
          </div>

          <!-- Floating badges -->
          <div class="absolute top-8 -right-4 card-neon p-3 animate-float" style="animation-delay: 0s;">
            <div class="flex items-center gap-2">
              <span class="text-2xl">🔧</span>
              <div>
                <div class="text-xs text-gray-400">Diagnóstico</div>
                <div class="text-sm font-bold text-neon-400">Computarizado</div>
              </div>
            </div>
          </div>
          <div class="absolute bottom-12 -left-4 card-neon p-3 animate-float" style="animation-delay: 1s;">
            <div class="flex items-center gap-2">
              <span class="text-2xl">⚡</span>
              <div>
                <div class="text-xs text-gray-400">Respuesta</div>
                <div class="text-sm font-bold text-neon-400">45-60 min</div>
              </div>
            </div>
          </div>
          <div class="absolute top-1/2 -right-8 card-neon p-3 animate-float" style="animation-delay: 2s;">
            <div class="flex items-center gap-2">
              <span class="text-2xl">🛡️</span>
              <div>
                <div class="text-xs text-gray-400">Garantía</div>
                <div class="text-sm font-bold text-neon-400">3-12 meses</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
