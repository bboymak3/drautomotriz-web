---
// ============================================================
// Trabajo destacado: Chevrolet NKR 512 - Cambio kit de embrague
// Fotos en /public/imagen/nuevoset/chevrolet-nkr-512/
// ============================================================
import TrabajoModal from '@/components/TrabajoModal.astro';

const { compacto = false } = Astro.props;

const base = '/imagen/nuevoset/chevrolet-nkr-512/drmecanico-automotriz-taller-en-penalolen-chevrolet-nkr-512-cambio-kit-de-embrague';

const fotos = [
  { src: `${base}-5.webp`, label: 'Kit nuevo vs usado', alt: 'Kit de embrague nuevo vs usado Chevrolet NKR 512: prensa y disco de embrague - taller en Peñalolén' },
  { src: `${base}-1.webp`, label: 'Cabina abatida', alt: 'Chevrolet NKR 512 con cabina abatida para cambio de kit de embrague - taller mecánico en Peñalolén DRAUTOMOTRIZ' },
  { src: `${base}-3.webp`, label: 'Camión en trabajo', alt: 'Mecánico trabajando bajo Chevrolet NKR 512 en cambio de embrague - DRAUTOMOTRIZ Peñalolén' },
  { src: `${base}-2.webp`, label: 'Desmontaje', alt: 'Chevrolet NKR 512 durante desmontaje de caja para cambio de kit de embrague en Peñalolén' },
  { src: `${base}-7.webp`, label: 'Embrague montado', alt: 'Prensa de embrague montada en volante de motor Chevrolet NKR 512 - cambio kit de embrague' },
  { src: `${base}-4.webp`, label: 'Collarín nuevo vs usado', alt: 'Collarín de embrague nuevo vs gastado Chevrolet NKR 512 - cambio kit de embrague DRAUTOMOTRIZ' },
  { src: `${base}-6.webp`, label: 'Maza y frenos', alt: 'Revisión de maza y frenos traseros Chevrolet NKR 512 durante cambio de embrague en Peñalolén' },
];
---

<TrabajoModal
  compacto={compacto}
  id="modal-chevrolet-nkr-512"
  vehiculo="Chevrolet NKR 512"
  titulo="Cambio Kit de Embrague"
  descripcion='Cambio completo de kit de embrague a un camión Chevrolet NKR 512: prensa, disco y collarín nuevos, con revisión de maza y frenos traseros. Un trabajo pesado que hacemos en terreno o en nuestro <strong class="text-white">taller mecánico en Peñalolén</strong>, para que tu vehículo de trabajo vuelva rápido a la ruta.'
  items={[
    'Abatimiento de cabina y desmontaje de caja de cambios',
    'Reemplazo de prensa y disco de embrague',
    'Collarín de embrague nuevo',
    'Revisión de volante, maza y frenos traseros',
    'Prueba de ruta y ajuste final',
  ]}
  fotos={fotos}
  portada={fotos[0]}
  whatsappTexto="Hola! Quiero cotizar cambio de kit de embrague para mi camión Chevrolet NKR"
  servicio={{ href: '/servicios/cambio-kit-de-embrague/', nombre: 'Ver servicio de embrague' }}
/>
