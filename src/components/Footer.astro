---
import { config, waLink } from '@/data/config';
import { servicios } from '@/data/servicios';
import { comunas } from '@/data/comunas';
import { marcas, totalVehiculos } from '@/data/marcas';

const year = new Date().getFullYear();

// Servicios para el footer (top 6)
const serviciosTop = servicios.slice(0, 6);

// Comunas destacadas
const comunasTop = comunas.slice(0, 12);

// Marcas destacadas
const marcasTop = marcas.slice(0, 10);
---

<footer class="bg-dark-400 border-t border-neon-500/20 mt-20">
  <!-- CTA superior -->
  <div class="container-x py-12 border-b border-neon-500/10">
    <div class="grid md:grid-cols-2 gap-8 items-center">
      <div>
        <h3 class="text-2xl md:text-3xl font-display font-bold text-white mb-3">
          ¿Necesitas un <span class="text-neon-400 glow-text">mecánico a domicilio</span> en Santiago?
        </h3>
        <p class="text-gray-400">
          Atendemos toda la Región Metropolitana, 24/7, con mecánicos certificados y repuestos de calidad. Escríbenos por WhatsApp y coordinamos la visita.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 md:justify-end">
        <a href={waLink()} target="_blank" rel="noopener" class="btn-whatsapp">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          +569 6240 8735
        </a>
        <a href="/contacto" class="btn-outline-neon">Solicitar Cotización</a>
      </div>
    </div>
  </div>

  <!-- Footer principal -->
  <div class="container-x py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      <!-- Columna 1: Marca -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <img
            src="/imagen/logo/drautomotriz-logo.webp"
            alt="Logo DRAUTOMOTRIZ"
            width="40"
            height="40"
            class="w-10 h-10 object-contain rounded-lg"
            loading="lazy"
          />
          <div class="flex flex-col leading-none">
            <span class="font-display font-bold text-lg text-white tracking-wider">DRAUTOMOTRIZ</span>
            <span class="text-[10px] text-neon-400 uppercase tracking-widest">Mecánico a Domicilio</span>
          </div>
        </div>
        <p class="text-sm text-gray-400">
          Servicio automotriz y mecánico a domicilio en Santiago. Diagnóstico, mantención, reparación y auxilio 24/7 en toda la Región Metropolitana.
        </p>
        <div class="flex items-center gap-3">
          <a href={config.instagramUrl} target="_blank" rel="noopener" aria-label="Instagram"
            class="w-9 h-9 flex items-center justify-center rounded-lg border border-neon-500/30 text-neon-400 hover:bg-neon-500 hover:text-dark-500 hover:shadow-neon transition-all">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href={waLink()} target="_blank" rel="noopener" aria-label="WhatsApp"
            class="w-9 h-9 flex items-center justify-center rounded-lg border border-neon-500/30 text-neon-400 hover:bg-neon-500 hover:text-dark-500 hover:shadow-neon transition-all">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna 2: Servicios -->
      <div>
        <h4 class="text-sm font-display font-bold uppercase tracking-widest text-neon-400 mb-4">Servicios</h4>
        <ul class="space-y-2">
          {serviciosTop.map(s => (
            <li>
              <a href={`/servicios/${s.slug}`} class="text-sm text-gray-400 hover:text-neon-400 transition-colors">
                {s.nombre}
              </a>
            </li>
          ))}
          <li>
            <a href="/servicios" class="text-sm text-neon-400 font-semibold hover:underline">Ver todos los servicios →</a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Comunas -->
      <div>
        <h4 class="text-sm font-display font-bold uppercase tracking-widest text-neon-400 mb-4">Comunas</h4>
        <ul class="space-y-2 grid grid-cols-2 gap-x-4">
          {comunasTop.map(c => (
            <li>
              <a href={`/comunas/${c.slug}`} class="text-sm text-gray-400 hover:text-neon-400 transition-colors">
                {c.nombre}
              </a>
            </li>
          ))}
          <li class="col-span-2">
            <a href="/comunas" class="text-sm text-neon-400 font-semibold hover:underline">Ver todas las comunas →</a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Vehículos / Marcas -->
      <div>
        <h4 class="text-sm font-display font-bold uppercase tracking-widest text-neon-400 mb-4">Vehículos</h4>
        <ul class="space-y-2">
          {marcasTop.map(m => (
            <li>
              <a href={`/vehiculos#${m.slug}`} class="text-sm text-gray-400 hover:text-neon-400 transition-colors">
                {m.nombre}
              </a>
            </li>
          ))}
          <li>
            <a href="/vehiculos/todos" class="text-sm text-neon-400 font-semibold hover:underline">★ Ver todos los vehículos →</a>
          </li>
        </ul>
      </div>

      <!-- Columna 5: Contacto -->
      <div>
        <h4 class="text-sm font-display font-bold uppercase tracking-widest text-neon-400 mb-4">Contacto</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-neon-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>Santiago, Región Metropolitana<br/><span class="text-neon-400">Cobertura 40+ comunas</span></span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-neon-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>{config.horario}</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-neon-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <a href={waLink()} target="_blank" rel="noopener" class="hover:text-neon-400 transition-colors">+569 6240 8735</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-neon-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <a href={config.instagramUrl} target="_blank" rel="noopener" class="hover:text-neon-400 transition-colors">{config.instagram}</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Footer bottom -->
  <div class="border-t border-neon-500/10">
    <div class="container-x py-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs text-gray-500 text-center md:text-left">
        © {year} {config.marca}. Todos los derechos reservados. Servicio mecánico a domicilio en Santiago, Chile.
      </p>
      <div class="flex flex-wrap items-center gap-4 text-xs">
        <a href="/quienes-somos" class="text-gray-500 hover:text-neon-400 transition-colors">Quiénes Somos</a>
        <a href="/contacto" class="text-gray-500 hover:text-neon-400 transition-colors">Contacto</a>
        <a href="/politicas-de-privacidad" class="text-gray-500 hover:text-neon-400 transition-colors">Políticas de Privacidad</a>
        <a href="/sitemap.xml" class="text-gray-500 hover:text-neon-400 transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
