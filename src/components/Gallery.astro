---
import { waLink } from '@/data/config';
import fs from 'node:fs';
import path from 'node:path';

// Leer fotos de /public/imagen/drautomotriz/ (primeras 12 para home)
const galeriaDir = path.join(process.cwd(), 'public', 'imagen', 'drautomotriz');
let fotosHome: { src: string; alt: string; categoria: string }[] = [];
try {
  const allFiles = fs.readdirSync(galeriaDir)
    .filter(f => /\.(jpg|jpeg|png|webp)$/i.test(f))
    .sort();

  fotosHome = allFiles.slice(0, 12).map(f => {
    const src = `/imagen/drautomotriz/${f}`;
    const filename = f.replace(/\.(jpg|jpeg|png|webp)$/i, '');
    let categoria = 'trabajo';
    if (f.includes('frenos')) categoria = 'frenos';
    else if (f.includes('motor')) categoria = 'motor';
    else if (f.includes('neumatico') || f.includes('suspension')) categoria = 'suspension';
    else if (f.match(/drautomotriz-(chevrolet|toyota|hyundai|kia|mazda|honda|ford|peugeot|renault|subaru|suzuki|volkswagen|nissan)/)) categoria = 'vehiculo';
    else if (f.includes('revision')) categoria = 'revision';
    else if (f.includes('taller') || f.includes('logo')) categoria = 'taller';

    const alt = filename
      .replace(/-/g, ' ')
      .replace(/\b\w/g, c => c.toUpperCase());

    return { src, alt, categoria };
  });
} catch (e) {
  console.warn('No se pudo leer galeria:', e);
}
---

<section id="galeria" class="py-20 relative overflow-hidden">
  <div class="container-x">
    <div class="text-center mb-12">
      <span class="badge-neon mb-4">Galería</span>
      <h2 class="section-title">Trabajos en Santiago</h2>
      <p class="section-subtitle">
        Fotos reales de trabajos mecánicos a domicilio realizados en distintas comunas de la Región Metropolitana. Cada imagen representa el tipo de servicio que podemos realizar en tu vehículo.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {fotosHome.map(foto => (
        <a
          href="/galeria"
          class="group relative aspect-square rounded-xl overflow-hidden border-2 border-neon-500/20 hover:border-neon-500/60 transition-all"
        >
          <img
            src={foto.src}
            alt={foto.alt}
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-dark-400/95 via-dark-300/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
            <div>
              <div class="text-xs text-neon-400 uppercase tracking-wide mb-1">{foto.categoria}</div>
              <h3 class="text-sm font-display font-bold text-white line-clamp-2">{foto.alt}</h3>
            </div>
          </div>
          <div class="absolute top-2 right-2 px-2 py-1 bg-dark-300/80 backdrop-blur rounded text-[10px] text-neon-400 uppercase tracking-wide border border-neon-500/30">
            {foto.categoria}
          </div>
        </a>
      ))}
    </div>

    <div class="text-center mt-10">
      <p class="text-sm text-gray-500 mb-4">
        ¿Quieres ver la galería completa o tienes preguntas sobre un servicio específico?
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/galeria" class="btn-outline-neon text-sm">Ver galería completa</a>
        <a href={waLink('Hola, quiero ver ejemplos de trabajos')} target="_blank" rel="noopener" class="btn-whatsapp text-sm">
          Solicitar ejemplos
        </a>
      </div>
    </div>
  </div>
</section>
