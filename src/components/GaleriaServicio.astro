---
import fs from 'node:fs';
import path from 'node:path';
import { servicios } from '@/data/servicios';
import { waLink } from '@/data/config';

interface Props {
  servicioSlug?: string;
  servicioNombre?: string;
}

const { servicioSlug, servicioNombre } = Astro.props;

// Categoría basada en el servicio
let categoriaFiltro = 'todos';
if (servicioSlug) {
  const servicio = servicios.find(s => s.slug === servicioSlug);
  if (servicio) {
    // Mapear categoria del servicio a categoria de galería
    if (servicio.categoria.toLowerCase().includes('frenos')) categoriaFiltro = 'frenos';
    else if (servicio.categoria.toLowerCase().includes('motor')) categoriaFiltro = 'motor';
    else if (servicio.categoria.toLowerCase().includes('suspension') || servicio.categoria.toLowerCase().includes('dirección')) categoriaFiltro = 'suspension';
    else if (servicio.categoria.toLowerCase().includes('diagnóstic') || servicio.categoria.toLowerCase().includes('escáner')) categoriaFiltro = 'diagnostico';
    else if (servicio.categoria.toLowerCase().includes('aire') || servicio.categoria.toLowerCase().includes('refriger')) categoriaFiltro = 'refrigeracion';
    else if (servicio.categoria.toLowerCase().includes('distribuc')) categoriaFiltro = 'distribucion';
    else if (servicio.categoria.toLowerCase().includes('embrague')) categoriaFiltro = 'embrague';
    else if (servicio.categoria.toLowerCase().includes('óptic') || servicio.categoria.toLowerCase().includes('focos')) categoriaFiltro = 'opticos';
    else if (servicio.categoria.toLowerCase().includes('aceite')) categoriaFiltro = 'aceites';
    else if (servicio.categoria.toLowerCase().includes('revisión') || servicio.categoria.toLowerCase().includes('trámite')) categoriaFiltro = 'revision';
  }
}

// Leer fotos de /public/imagen/drautomotriz/
const galeriaDir = path.join(process.cwd(), 'public', 'imagen', 'drautomotriz');
let fotosGaleria: { src: string; alt: string; categoria: string }[] = [];
try {
  const allFiles = fs.readdirSync(galeriaDir)
    .filter(f => /\.(jpg|jpeg|png|webp)$/i.test(f))
    .sort();

  fotosGaleria = allFiles.map(f => {
    const src = `/imagen/drautomotriz/${f}`;
    const filename = f.replace(/\.(jpg|jpeg|png|webp)$/i, '');
    let categoria = 'trabajo';
    if (f.includes('frenos')) categoria = 'frenos';
    else if (f.includes('motor')) categoria = 'motor';
    else if (f.includes('suspension') || f.includes('neumatico')) categoria = 'suspension';
    else if (f.includes('escaner') || f.includes('diagnost')) categoria = 'diagnostico';
    else if (f.includes('aire') || f.includes('refriger')) categoria = 'refrigeracion';
    else if (f.includes('distribuc')) categoria = 'distribucion';
    else if (f.includes('embrague')) categoria = 'embrague';
    else if (f.includes('opticos') || f.includes('focos')) categoria = 'opticos';
    else if (f.includes('aceite')) categoria = 'aceites';
    else if (f.includes('revision')) categoria = 'revision';
    else if (f.includes('taller') || f.includes('logo')) categoria = 'taller';
    else if (f.match(/drautomotriz-(chevrolet|toyota|hyundai|kia|mazda|honda|ford|peugeot|renault|subaru|suzuki|volkswagen|nissan|fiat|mg)/)) categoria = 'vehiculo';

    const alt = filename
      .replace(/-/g, ' ')
      .replace(/\b\w/g, c => c.toUpperCase());

    return { src, alt, categoria };
  });
} catch (e) {
  console.warn('No se pudo leer galeria:', e);
}

// Filtrar fotos por categoria del servicio, si no hay suficientes, mostrar todas
let fotosServicio = fotosGaleria;
if (categoriaFiltro !== 'todos') {
  const filtradas = fotosGaleria.filter(f => f.categoria === categoriaFiltro);
  if (filtradas.length >= 4) {
    fotosServicio = filtradas;
  } else {
    // Si no hay suficientes de la categoria, mezclar algunas de la categoria + generales
    fotosServicio = [...filtradas, ...fotosGaleria.filter(f => f.categoria === 'trabajo').slice(0, 8 - filtradas.length)];
  }
}

// Mostrar primeras 8 fotos en el grid
const fotosAMostrar = fotosServicio.slice(0, 8);
const totalFotos = fotosServicio.length;
---

<section class="py-12 relative overflow-hidden">
  <div class="absolute inset-0 bg-grid opacity-10"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-neon-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container-x relative">
    <div class="text-center mb-8">
      <span class="badge-neon mb-3">Galería</span>
      <h2 class="text-2xl md:text-3xl font-display font-bold text-white mb-3">
        {servicioNombre ? `Fotos de ${servicioNombre}` : 'Galería de Trabajos'}
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto text-sm md:text-base">
        Galería de trabajos realizados en Santiago. Cada foto representa el tipo de servicio que podemos realizar en tu vehículo.
      </p>
    </div>

    <!-- Grid de fotos (8 fotos) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
      {fotosAMostrar.map((foto, i) => (
        <a
          href="/galeria"
          class="group relative aspect-square rounded-xl overflow-hidden border border-neon-500/20 hover:border-neon-500/60 transition-all"
        >
          <img
            src={foto.src}
            alt={foto.alt}
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-dark-400/90 via-transparent to-transparent opacity-60 group-hover:opacity-90 transition-opacity"></div>
          <div class="absolute bottom-2 left-2 right-2 text-center">
            <div class="text-[8px] md:text-[10px] text-neon-400 uppercase tracking-wide font-semibold truncate">
              {foto.categoria}
            </div>
            <div class="text-[9px] md:text-[11px] text-white font-bold leading-tight line-clamp-1">
              {foto.alt.split(' ').slice(0, 3).join(' ')}
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Botón Ver más -->
    <div class="text-center mt-8">
      <a href="/galeria" class="btn-outline-neon text-sm">
        Ver galería completa ({totalFotos} fotos)
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
