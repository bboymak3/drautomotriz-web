---
import { waLink } from '@/data/config';
---

<section class="py-20 relative overflow-hidden">
  <div class="absolute inset-0 bg-grid opacity-10"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-neon-500/5 rounded-full blur-3xl"></div>

  <div class="container-x relative">
    <div class="max-w-5xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-8 items-stretch">

        <!-- Left: Banner 4:3 -->
        <div class="relative">
          <div class="absolute -inset-2 rounded-2xl bg-gradient-neon opacity-20 blur-xl"></div>
          <div class="relative aspect-4/3 rounded-2xl overflow-hidden border-2 border-neon-500/40 shadow-neon-lg">
            <img
              src="/imagen/banner/agenda-tu-servicio.jpeg"
              alt="Agenda tu servicio mecánico a domicilio en Santiago con DRAUTOMOTRIZ - Mecánico certificado a domicilio"
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <!-- Overlay gradiente -->
            <div class="absolute inset-0 bg-gradient-to-t from-dark-400/90 via-dark-300/30 to-transparent"></div>

            <!-- Contenido sobre la imagen -->
            <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
              <div class="badge-neon mb-3">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-neon-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-neon-500"></span>
                </span>
                Disponible 24/7
              </div>
              <h3 class="text-2xl md:text-3xl font-display font-bold text-white mb-2 glow-text">
                Agenda Tu Servicio
              </h3>
              <p class="text-sm text-gray-300">
                Respuesta inmediata por WhatsApp en toda la Región Metropolitana
              </p>
            </div>
          </div>
        </div>

        <!-- Right: Contenido y CTA -->
        <div class="flex flex-col justify-center">
          <span class="badge-neon mb-4 w-fit">Solicitar Cotización</span>

          <h2 class="text-3xl md:text-4xl font-display font-extrabold text-white mb-6 leading-tight">
            ¿Listo para <span class="text-transparent bg-clip-text bg-gradient-neon glow-text">agendar tu servicio</span>?
          </h2>

          <p class="text-gray-300 mb-6 leading-relaxed">
            Escríbenos por WhatsApp y recibe una cotización en minutos. Nuestro equipo te responderá con disponibilidad, valor estimado y tiempo de llegada del mecánico a tu ubicación en Santiago.
          </p>

          <!-- Lista de ventajas -->
          <div class="space-y-3 mb-8">
            <div class="flex items-center gap-3 text-sm">
              <div class="w-7 h-7 rounded-full bg-neon-500/10 border border-neon-500/30 flex items-center justify-center text-neon-400 shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-gray-300">Respuesta en 5-15 minutos por WhatsApp</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <div class="w-7 h-7 rounded-full bg-neon-500/10 border border-neon-500/30 flex items-center justify-center text-neon-400 shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-gray-300">Presupuesto transparente, sin costos ocultos</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <div class="w-7 h-7 rounded-full bg-neon-500/10 border border-neon-500/30 flex items-center justify-center text-neon-400 shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-gray-300">Mecánico llega en 45-60 min a tu ubicación</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <div class="w-7 h-7 rounded-full bg-neon-500/10 border border-neon-500/30 flex items-center justify-center text-neon-400 shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-gray-300">Garantía escrita en todos los trabajos</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <div class="w-7 h-7 rounded-full bg-neon-500/10 border border-neon-500/30 flex items-center justify-center text-neon-400 shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <span class="text-gray-300">Repuestos OEM de calidad con factura</span>
            </div>
          </div>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={waLink()} target="_blank" rel="noopener" class="btn-whatsapp animate-pulse-neon">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              +569 6240 8735
            </a>
            <a href="/contacto" class="btn-outline-neon">
              Formulario de cotización
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
