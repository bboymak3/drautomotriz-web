---
import { config } from '@/data/config';

// Modal de reviews de Google que aparece automaticamente
// Link: https://share.google/Bs9skBo4DiTWcXzY6
---

<!-- Boton flotante de Google Reviews -->
<button
  id="googleReviewsBtn"
  aria-label="Ver reseñas de Google"
  class="fixed bottom-20 md:bottom-6 left-4 md:left-6 z-40 group"
>
  <div class="relative">
    <span class="absolute inset-0 rounded-full bg-blue-500 opacity-75 animate-ping"></span>
    <div class="relative w-14 h-14 md:w-16 md:h-16 rounded-full bg-white flex items-center justify-center shadow-[0_0_30px_rgba(66,133,244,0.6)] group-hover:scale-110 transition-transform border-2 border-blue-500">
      <svg class="w-7 h-7 md:w-9 md:h-9" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
      </svg>
    </div>
  </div>
</button>

<!-- Modal de Google Reviews -->
<div id="googleReviewsModal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
  <!-- Overlay -->
  <div class="absolute inset-0 bg-dark-500/90 backdrop-blur-sm" id="googleReviewsOverlay"></div>

  <!-- Contenido del modal -->
  <div class="relative bg-white rounded-2xl shadow-2xl max-w-md w-full overflow-hidden">
    <!-- Header con gradiente Google -->
    <div class="bg-gradient-to-r from-blue-500 via-green-500 to-red-500 p-0.5">
      <div class="bg-white rounded-2xl">
        <!-- Cerrar -->
        <button id="closeGoogleReviews" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center transition-colors z-10">
          <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>

        <!-- Contenido -->
        <div class="p-6 md:p-8 text-center">
          <!-- Logo Google -->
          <div class="flex items-center justify-center mb-4">
            <svg class="w-12 h-12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
          </div>

          <h3 class="text-xl font-bold text-gray-900 mb-2">Reseñas de Google</h3>

          <!-- Rating -->
          <div class="flex items-center justify-center gap-2 mb-4">
            <div class="flex">
              <svg class="w-6 h-6 text-yellow-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg class="w-6 h-6 text-yellow-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg class="w-6 h-6 text-yellow-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg class="w-6 h-6 text-yellow-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg class="w-6 h-6 text-yellow-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <span class="text-2xl font-bold text-gray-900">4.9</span>
            <span class="text-sm text-gray-500">/ 5.0</span>
          </div>

          <p class="text-gray-600 text-sm mb-1">Basado en <strong>148+ reseñas</strong></p>
          <p class="text-gray-500 text-xs mb-6">en Google Business</p>

          <!-- CTA -->
          <a href="https://share.google/Bs9skBo4DiTWcXzY6" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-bold rounded-lg hover:from-blue-600 hover:to-blue-700 transition-all shadow-lg">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#fff"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#fff"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#fff"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#fff"/>
            </svg>
            Ver perfil de Google
          </a>

          <p class="text-gray-400 text-xs mt-4">O déjanos tu reseña haciendo clic arriba</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Mostrar modal automaticamente despues de 5 segundos (solo primera visita)
  const modal = document.getElementById('googleReviewsModal');
  const btn = document.getElementById('googleReviewsBtn');
  const closeBtn = document.getElementById('closeGoogleReviews');
  const overlay = document.getElementById('googleReviewsOverlay');

  // Mostrar al hacer click en el boton
  btn?.addEventListener('click', () => {
    showModal();
  });

  // Mostrar automaticamente despues de 5s si no se ha visto antes
  if (!sessionStorage.getItem('googleReviewsShown')) {
    setTimeout(() => {
      showModal();
      sessionStorage.setItem('googleReviewsShown', '1');
    }, 5000);
  }

  function showModal() {
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  }

  function hideModal() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }

  closeBtn?.addEventListener('click', hideModal);
  overlay?.addEventListener('click', hideModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hideModal();
  });
</script>
