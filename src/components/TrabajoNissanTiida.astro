---
// ============================================================
// Trabajo destacado: Nissan Tiida
// Mantención por km + correa de accesorios + cuerpo de aceleración
// Fotos en /public/imagen/nuevoset/nissan-tiida/
// ============================================================
import TrabajoModal from '@/components/TrabajoModal.astro';

const base = '/imagen/nuevoset/nissan-tiida/drmecanico-automotriz-taller-en-penalolen-nissan-tiida-';

const fotos = [
  { src: `${base}mantencion-por-km.webp`, label: 'Nissan Tiida en servicio', alt: 'Nissan Tiida en mantención por kilometraje - DRAUTOMOTRIZ taller mecánico en Peñalolén' },
  { src: `${base}mantencion-por-km-motor.webp`, label: 'Motor', alt: 'Motor Nissan Tiida durante mantención por km - mecánico en Peñalolén' },
  { src: `${base}mantencion-por-km-cambio-de-bujias.webp`, label: 'Bujías usada vs nueva', alt: 'Cambio de bujías Nissan Tiida: bujía usada vs nueva NGK - mantención por kilometraje' },
  { src: `${base}mantencion-por-km-cambio-filtro-de-habitaculo.webp`, label: 'Filtro de habitáculo', alt: 'Filtro de habitáculo nuevo vs usado Nissan Tiida - mantención por km en Peñalolén' },
  { src: `${base}cambio-correa-de-accesorios.webp`, label: 'Correa de accesorios', alt: 'Cambio de correa de accesorios Nissan Tiida - DRAUTOMOTRIZ Peñalolén' },
  { src: `${base}limpieza-y-calibracion-cuerpo-de-aceleracion-2.webp`, label: 'Cuerpo de aceleración', alt: 'Cuerpo de aceleración Nissan Tiida antes de limpieza y calibración' },
  { src: `${base}limpieza-y-calibracion-cuerpo-de-aceleracion-1.webp`, label: 'Limpieza', alt: 'Limpieza de cuerpo de aceleración Nissan Tiida - taller mecánico en Peñalolén' },
  { src: `${base}limpieza-y-calibracion-cuerpo-de-aceleracion-3.webp`, label: 'Calibración', alt: 'Cuerpo de aceleración Nissan Tiida limpio listo para calibración' },
  { src: `${base}kit-de-embrague-nuevo-vs-usado.webp`, label: 'Kit de embrague', alt: 'Kit de embrague nuevo vs usado Nissan Tiida: prensa y disco - DRAUTOMOTRIZ' },
];
---

<TrabajoModal
  id="modal-nissan-tiida"
  vehiculo="Nissan Tiida"
  titulo="Mantención por Km"
  descripcion='Mantención por kilometraje completa a un Nissan Tiida: cambio de bujías y filtro de habitáculo, <strong class="text-white">cambio de correa de accesorios</strong> y <strong class="text-white">limpieza y calibración del cuerpo de aceleración</strong>. Lo hacemos a domicilio o en nuestro <strong class="text-white">taller mecánico en Peñalolén</strong>.'
  items={[
    'Mantención por kilometraje',
    'Cambio de bujías y filtro de habitáculo',
    'Cambio de correa de accesorios',
    'Limpieza y calibración del cuerpo de aceleración',
  ]}
  fotos={fotos}
  portada={fotos[0]}
  whatsappTexto="Hola! Quiero cotizar mantención por km para mi Nissan Tiida"
  servicio={{ href: '/servicios/mantencion-por-km/', nombre: 'Ver servicio' }}
/>
