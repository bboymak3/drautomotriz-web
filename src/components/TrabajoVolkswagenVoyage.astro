---
// ============================================================
// Trabajo destacado: Volkswagen Voyage
// Mantención por km + recarga y mantención de aire acondicionado
// Fotos en /public/imagen/nuevoset/volkswagen-voyage/
// ============================================================
import TrabajoModal from '@/components/TrabajoModal.astro';

const { compacto = false } = Astro.props;

const base = '/imagen/nuevoset/volkswagen-voyage/mecanico-a-domicilio-en-penalolen-volkswagen-voyage';

const fotos = [
  { src: `${base}-recarga-y-mantencion-de-aire-acondicionado.webp`, label: 'Recarga de aire acondicionado', alt: 'Recarga y mantención de aire acondicionado Volkswagen Voyage con manómetros - mecánico a domicilio en Peñalolén DRAUTOMOTRIZ' },
  { src: `${base}-mantencion-por-km-cambio-filtro-de-aceite.webp`, label: 'Filtro de aceite', alt: 'Filtro de aceite original VW nuevo vs usado Volkswagen Voyage - mantención por km a domicilio en Peñalolén' },
  { src: `${base}-mantencion-por-km-filtro-de-aceite-nuevo-vs-usado.webp`, label: 'Filtro de aceite nuevo vs usado', alt: 'Filtro de aceite usado vs nuevo Volkswagen Voyage - mantención por kilometraje en Peñalolén' },
  { src: `${base}-mantencion-por-km-cambio-filtro-de-aire.webp`, label: 'Filtro de aire', alt: 'Filtro de aire usado vs nuevo Volkswagen Voyage - mantención por km a domicilio en Peñalolén' },
  { src: `${base}-mantencion-por-km-cambio-filtro-de-habitaculo.webp`, label: 'Filtro de habitáculo', alt: 'Filtro de habitáculo nuevo vs usado Volkswagen Voyage - mantención por km y aire acondicionado DRAUTOMOTRIZ' },
];
---

<TrabajoModal
  compacto={compacto}
  id="modal-volkswagen-voyage"
  vehiculo="Volkswagen Voyage"
  titulo="Mantención por Km y Aire Acondicionado"
  descripcion='<strong class="text-white">Mantención por kilometraje</strong> a un Volkswagen Voyage con cambio de filtros de aceite, aire y habitáculo, más <strong class="text-white">recarga y mantención de aire acondicionado</strong> con manómetros. Lo hacemos como <strong class="text-white">mecánico a domicilio en Peñalolén</strong> y toda la Región Metropolitana.'
  items={[
    'Cambio de aceite y filtro de aceite original',
    'Cambio de filtro de aire',
    'Cambio de filtro de habitáculo',
    'Recarga y mantención de aire acondicionado',
  ]}
  fotos={fotos}
  portada={fotos[0]}
  whatsappTexto="Hola! Quiero cotizar mantención por km y recarga de aire acondicionado para mi Volkswagen Voyage"
  servicio={{ href: '/servicios/recarga-y-mantencion-de-aire-acondicionado/', nombre: 'Ver servicio de aire acondicionado' }}
/>
