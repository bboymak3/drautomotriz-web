---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppCTA from '@/components/WhatsAppCTA.astro';
import BottomNav from '@/components/BottomNav.astro';
import GoogleReviewsModal from '@/components/GoogleReviewsModal.astro';
import TapizadoVolantes from '@/components/TapizadoVolantes.astro';
import { config } from '@/data/config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  skipBreadcrumb?: boolean;
  skipAutoRepair?: boolean;
}

const {
  title = `${config.marca} - Mecánico a Domicilio en Santiago | Diagnóstico, Mantención y Reparación`,
  description = 'Servicio automotriz y mecánico a domicilio en Santiago. Diagnóstico computarizado, mantención preventiva, frenos, suspensión, batería y auxilio 24/7. Agenda por WhatsApp.',
  ogImage = '/og-image.png',
  canonical,
  skipBreadcrumb = false,
  skipAutoRepair = false,
} = Astro.props;

const currentUrl = canonical || Astro.url.pathname;
const fullUrl = new URL(currentUrl, config.dominio).toString();
const ogImageUrl = new URL(ogImage, config.dominio).toString();
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="mecanico a domicilio santiago, servicio automotriz domicilio, diagnostico computarizado auto, mantencion auto casa, auxilio mecanico 24/7, drautomotriz" />
    <meta name="author" content={config.marca} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={fullUrl} />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="AO8x2D5digAhJVNmj0wVdeJx60EpOc56vELa9rh_CmY" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`DRAUTOMOTRIZ - Mecánico a Domicilio en Santiago, Chile. Servicio automotriz a domicilio 24/7 en toda la Región Metropolitana.`} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={config.marca} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@dr_automotrizz" />
    <meta name="twitter:url" content={fullUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`DRAUTOMOTRIZ - Mecánico a Domicilio en Santiago`} />

    <!-- Favicon completo (todos los formatos) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={config.marca} />
    <meta name="application-name" content={config.marca} />
    <meta name="msapplication-TileColor" content="#00d4ff" />
    <meta name="msapplication-TileImage" content="/android-chrome-192x192.png" />

    <!-- Theme -->
    <meta name="theme-color" content="#00d4ff" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Structured Data: AutoRepair base (solo si la página no define el suyo propio) -->
    {!skipAutoRepair && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "AutoRepair",
        "name": config.marca,
        "image": ogImage,
        "description": "Servicio mecánico a domicilio en Santiago, Chile. Diagnóstico, mantención, frenos, batería, suspensión, revisión técnica sin estrés y auxilio 24/7.",
        "url": config.dominio,
        "telephone": `+${config.whatsappNumero}`,
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Santiago",
          "addressRegion": "Región Metropolitana",
          "addressCountry": "CL"
        },
        "areaServed": "Santiago, Región Metropolitana",
        "openingHours": "Mo-Sa 08:00-20:00, Su 00:00-24:00",
        "priceRange": "$$",
        "sameAs": [config.instagramUrl]
      })} />
    )}

    <!-- BreadcrumbList Schema (genérico - solo si la página no define el suyo) -->
    {!skipBreadcrumb && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Inicio",
            "item": `${config.dominio}/`
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": title.split('|')[0].trim(),
            "item": fullUrl.endsWith('/') ? fullUrl : `${fullUrl}/`
          }
        ]
      })} />
    )}

    <!-- Preconnect to WhatsApp for faster CTA -->
    <link rel="preconnect" href="https://wa.me" />

    <!-- Leaflet CSS para mapa interactivo -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5BC8WQPG');</script>
    <!-- End Google Tag Manager -->

    <!-- Google tag (gtag.js) - GA4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5NGSZYCZH8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5NGSZYCZH8');
    </script>
    <!-- End Google tag (gtag.js) -->
  </head>
  <body class="min-h-screen flex flex-col pt-16 md:pt-20">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5BC8WQPG"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <TapizadoVolantes />
    <Footer />
    <WhatsAppCTA />
    <BottomNav />
    <GoogleReviewsModal />
  </body>
</html>
