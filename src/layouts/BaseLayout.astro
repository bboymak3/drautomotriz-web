---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppCTA from '@/components/WhatsAppCTA.astro';
import BottomNav from '@/components/BottomNav.astro';
import { config } from '@/data/config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = `${config.marca} - Mecánico a Domicilio en Santiago | Diagnóstico, Mantención y Reparación`,
  description = 'Servicio automotriz y mecánico a domicilio en Santiago. Diagnóstico computarizado, mantención preventiva, frenos, suspensión, batería y auxilio 24/7. Agenda por WhatsApp.',
  ogImage = '/imagen/drautomotriz/og-default.jpg',
  canonical,
} = Astro.props;

const currentUrl = canonical || Astro.url.pathname;
const fullUrl = new URL(currentUrl, config.dominio).toString();
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="mecanico a domicilio santiago, servicio automotriz domicilio, diagnostico computarizado auto, mantencion auto casa, auxilio mecanico 24/7, drautomotriz" />
    <meta name="author" content={config.marca} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={fullUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={config.marca} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={fullUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Theme -->
    <meta name="theme-color" content="#00d4ff" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Structured Data: AutoRepair base (en cada página) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AutoRepair",
      "name": config.marca,
      "image": ogImage,
      "description": "Servicio mecánico a domicilio en Santiago, Chile. Diagnóstico, mantención, frenos, batería, suspensión, revisión técnica sin estrés y auxilio 24/7.",
      "url": config.dominio,
      "telephone": `+${config.whatsappNumero}`,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Santiago",
        "addressRegion": "Región Metropolitana",
        "addressCountry": "CL"
      },
      "areaServed": "Santiago, Región Metropolitana",
      "openingHours": "Mo-Sa 08:00-20:00, Su 00:00-24:00",
      "priceRange": "$$",
      "sameAs": [config.instagramUrl]
    })} />

    <!-- BreadcrumbList Schema (genérico para todas las páginas) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": config.dominio
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": title.split('|')[0].trim(),
          "item": fullUrl
        }
      ]
    })} />

    <!-- Preconnect to WhatsApp for faster CTA -->
    <link rel="preconnect" href="https://wa.me" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppCTA />
    <BottomNav />
  </body>
</html>
