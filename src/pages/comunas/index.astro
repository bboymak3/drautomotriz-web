---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { comunas, zonas, getComunasByZona } from '@/data/comunas';
import { waLink } from '@/data/config';

// Schema: ItemList con todas las comunas
const comunasListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Comunas con cobertura de mecánico a domicilio en Santiago",
  "description": `Listado de ${comunas.length} comunas de la Región Metropolitana donde DRAUTOMOTRIZ ofrece servicio mecánico a domicilio.`,
  "numberOfItems": comunas.length,
  "itemListElement": comunas.map((c, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Service",
      "name": `Mecánico a Domicilio en ${c.nombre}`,
      "url": `https://drmecanicoautomotriz.com/comunas/${c.slug}/`,
      "provider": { "@type": "AutoRepair", "name": "DRAUTOMOTRIZ" }
    }
  }))
};

// Schema: BreadcrumbList
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://drmecanicoautomotriz.com/" },
    { "@type": "ListItem", "position": 2, "name": "Comunas", "item": "https://drmecanicoautomotriz.com/comunas/" }
  ]
};
---

<BaseLayout
  title="Comunas que Cubrimos en Santiago | DRAUTOMOTRIZ"
  description="Mecánico a domicilio en más de 40 comunas de Santiago. Encuentra tu comuna y solicita el servicio. Atendemos Las Condes, Providencia, Maipú, La Florida, Ñuñoa y toda la RM."
  canonical="/comunas/"
  skipBreadcrumb={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(comunasListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <section class="pt-16 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl"></div>

    <div class="container-x relative">
      <div class="text-center mb-12">
        <span class="badge-neon mb-4">Cobertura</span>
        <h1 class="text-4xl md:text-5xl font-display font-extrabold text-white mb-6 text-balance">
          Comunas con cobertura en <span class="text-transparent bg-clip-text bg-gradient-neon glow-text">Santiago</span>
        </h1>
        <p class="text-lg text-gray-400 max-w-3xl mx-auto">
          Atendemos en más de 40 comunas de la Región Metropolitana, organizadas por zona. Cada comuna tiene su propia landing con información específica de cobertura y servicios disponibles.
        </p>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
        <div class="card-neon text-center">
          <div class="text-3xl font-display font-bold text-neon-400 glow-text">40+</div>
          <div class="text-xs text-gray-500 uppercase tracking-wide mt-1">Comunas</div>
        </div>
        <div class="card-neon text-center">
          <div class="text-3xl font-display font-bold text-neon-400 glow-text">5</div>
          <div class="text-xs text-gray-500 uppercase tracking-wide mt-1">Zonas RM</div>
        </div>
        <div class="card-neon text-center">
          <div class="text-3xl font-display font-bold text-neon-400 glow-text">45-60</div>
          <div class="text-xs text-gray-500 uppercase tracking-wide mt-1">Min llegada</div>
        </div>
        <div class="card-neon text-center">
          <div class="text-3xl font-display font-bold text-neon-400 glow-text">24/7</div>
          <div class="text-xs text-gray-500 uppercase tracking-wide mt-1">Disponibilidad</div>
        </div>
      </div>

      <!-- Grid por zonas -->
      <div class="space-y-12">
        {zonas.map(zona => {
          const lista = getComunasByZona(zona);
          return (
            <div>
              <div class="flex items-center gap-3 mb-6">
                <div class="w-2 h-10 bg-gradient-neon rounded"></div>
                <h2 class="text-2xl font-display font-bold text-white">
                  Zona <span class="text-neon-400">{zona}</span>
                </h2>
                <span class="text-sm text-gray-500">({lista.length} comunas)</span>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {lista.map(c => (
                  <a href={`/comunas/${c.slug}`} class="card-neon group">
                    <div class="flex items-center justify-between mb-2">
                      <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-neon-500/10 border border-neon-500/30 flex items-center justify-center text-neon-400 group-hover:shadow-neon transition-shadow">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                          </svg>
                        </div>
                        <div>
                          <h3 class="font-display font-bold text-white group-hover:text-neon-400 transition-colors">{c.nombre}</h3>
                          <div class="text-xs text-gray-500">Zona {c.zona}</div>
                        </div>
                      </div>
                      <svg class="w-5 h-5 text-neon-500/40 group-hover:text-neon-400 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </div>
                    <p class="text-xs text-gray-400 line-clamp-2">{c.descripcion}</p>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <!-- CTA -->
      <div class="mt-16 text-center">
        <div class="card-neon max-w-2xl mx-auto">
          <h3 class="text-xl font-display font-bold text-white mb-3">¿No ves tu comuna en la lista?</h3>
          <p class="text-gray-400 mb-6">
            Es muy probable que también te atendamos. Escríbenos por WhatsApp con tu comuna y verificamos cobertura al instante.
          </p>
          <a href={waLink('Hola, ¿atienden en mi comuna de Santiago?')} target="_blank" rel="noopener" class="btn-whatsapp">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Verificar cobertura
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
