---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { marcas, totalVehiculos, allModelos } from '@/data/marcas';
import { waLink } from '@/data/config';

const vehiculosSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Vehículos atendidos por DRAUTOMOTRIZ",
  "description": `Catálogo de ${totalVehiculos} vehículos reales de ${marcas.length} marcas que atendemos con servicio mecánico a domicilio en Santiago.`,
  "numberOfItems": totalVehiculos,
  "itemListElement": allModelos.slice(0, 20).map((m, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Thing",
      "name": `${m.marca} ${m.modelo}`,
      "url": `https://drautomotriz.pages.dev/vehiculos/${m.marcaSlug}/${m.modeloSlug}`
    }
  }))
};
---

<BaseLayout
  title={`Vehículos que Atendemos en Santiago | ${totalVehiculos} Modelos | DRAUTOMOTRIZ`}
  description={`Servicio mecánico a domicilio en Santiago para ${totalVehiculos} vehículos reales de ${marcas.length} marcas: Chevrolet, Toyota, Suzuki, Hyundai, Kia, Nissan, Mazda, Honda, Ford, Peugeot, Renault, Subaru, Volkswagen, Fiat y MG. WhatsApp +56962408735.`}
  canonical="/vehiculos"
>
  <script type="application/ld+json" set:html={JSON.stringify(vehiculosSchema)} />

  <section class="pt-16 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl"></div>

    <div class="container-x relative">
      <nav class="flex items-center gap-2 text-xs text-gray-500 mb-8">
        <a href="/" class="hover:text-neon-400 transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-neon-400">Vehículos</span>
      </nav>

      <div class="text-center mb-12">
        <span class="badge-neon mb-4">Catálogo</span>
        <h1 class="text-4xl md:text-5xl font-display font-extrabold text-white mb-6 text-balance">
          Vehículos que <span class="text-transparent bg-clip-text bg-gradient-neon glow-text">Atendemos</span>
        </h1>
        <p class="text-lg text-gray-400 max-w-3xl mx-auto">
          Atendemos <strong class="text-white">{totalVehiculos} vehículos reales</strong> de <strong class="text-white">{marcas.length} marcas</strong> con servicio mecánico a domicilio en toda la Región Metropolitana. Cada vehículo tiene su propia landing con fotografía real, información específica de los servicios disponibles y botón directo de cotización por WhatsApp.
        </p>
      </div>

      <div class="space-y-12">
        {marcas.map(marca => (
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="flex items-center gap-3">
                <div class="w-2 h-10 bg-gradient-neon rounded"></div>
                <div>
                  <h2 class="text-2xl font-display font-bold text-white">{marca.nombre}</h2>
                  <span class="text-xs text-gray-500 uppercase tracking-wide">{marca.modelos.length} modelo{marca.modelos.length > 1 ? 's' : ''}</span>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
              {marca.modelos.map(mod => {
                const imagen = mod.imagen || marca.imagen;
                const modSlug = mod.slug || mod.nombre.toLowerCase().replace(/\s+/g, '-');
                return (
                  <a href={`/vehiculos/${marca.slug}/${modSlug}`} class="group card-neon overflow-hidden">
                    <div class="aspect-4/3 overflow-hidden rounded-lg mb-3 bg-dark-100 relative">
                      {imagen ? (
                        <img src={imagen} alt={mod.alt || `${marca.nombre} ${mod.nombre} servicio mecánico a domicilio en Santiago - DRAUTOMOTRIZ`} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center bg-grid">
                          <span class="text-4xl text-neon-500/30">🚗</span>
                        </div>
                      )}
                      <div class="absolute inset-0 bg-gradient-to-t from-dark-400/80 via-transparent to-transparent opacity-60 group-hover:opacity-80 transition-opacity"></div>
                      <div class="absolute top-2 left-2 px-2 py-1 bg-dark-300/80 backdrop-blur rounded text-[10px] text-neon-400 uppercase tracking-wide border border-neon-500/30">
                        {marca.nombre}
                      </div>
                    </div>
                    <div class="px-1">
                      <h3 class="text-base font-display font-bold text-white group-hover:text-neon-400 transition-colors mb-1">
                        {marca.nombre} {mod.nombre}
                      </h3>
                      <div class="flex items-center justify-between text-xs text-gray-400">
                        <span>Ver servicios</span>
                        <svg class="w-4 h-4 text-neon-500/40 group-hover:text-neon-400 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>

      <div class="mt-16 text-center">
        <div class="card-neon max-w-2xl mx-auto">
          <h3 class="text-xl font-display font-bold text-white mb-3">¿No ves tu vehículo en la lista?</h3>
          <p class="text-gray-400 mb-6">
            Atendemos TODAS las marcas y modelos presentes en Chile. Escríbenos por WhatsApp y te confirmamos cobertura para tu vehículo específico.
          </p>
          <a href={waLink('Hola, ¿atienden mi vehículo en Santiago?')} target="_blank" rel="noopener" class="btn-whatsapp">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Consultar mi vehículo
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
