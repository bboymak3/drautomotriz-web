---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { vehiculos, totalVehiculos, marcas } from '@/data/marcas';
import { waLink } from '@/data/config';

// Schema.org
const todosSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Todos los vehículos atendidos por DRAUTOMOTRIZ`,
  "description": `Catálogo completo con los vehículos que atendemos con servicio mecánico a domicilio en Santiago.`,
  "numberOfItems": totalVehiculos,
  "itemListElement": vehiculos.map((v, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Thing",
      "name": `${v.marca} ${v.modelo}`,
      "image": `https://drmecanicoautomotriz.com${v.imagen}`,
      "url": `https://drmecanicoautomotriz.com/vehiculos/${v.marcaSlug}/${v.slug.split('-').slice(1).join('-') || v.modelo.toLowerCase().replace(/\s+/g, '-')}`
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://drmecanicoautomotriz.com/" },
    { "@type": "ListItem", "position": 2, "name": "Vehículos", "item": "https://drmecanicoautomotriz.com/vehiculos" },
    { "@type": "ListItem", "position": 3, "name": "Todos los vehículos", "item": "https://drmecanicoautomotriz.com/vehiculos/todos" }
  ]
};
---

<BaseLayout
  title={`Todos los Vehículos | Modelos con Foto Real | DRAUTOMOTRIZ`}
  description={`Catálogo completo con los vehículos reales que atendemos con servicio mecánico a domicilio en Santiago. Fotos reales de cada modelo con su landing específica.`}
  canonical="/vehiculos/todos"
>
  <script type="application/ld+json" set:html={JSON.stringify(todosSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="pt-16 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl"></div>

    <div class="container-x relative">
      <nav class="flex items-center gap-2 text-xs text-gray-500 mb-8">
        <a href="/" class="hover:text-neon-400 transition-colors">Inicio</a>
        <span>/</span>
        <a href="/vehiculos" class="hover:text-neon-400 transition-colors">Vehículos</a>
        <span>/</span>
        <span class="text-neon-400">Todos</span>
      </nav>

      <div class="text-center mb-12">
        <span class="badge-neon mb-4">Catálogo completo</span>
        <h1 class="text-4xl md:text-5xl font-display font-extrabold text-white mb-6 text-balance">
          Todos los <span class="text-transparent bg-clip-text bg-gradient-neon glow-text">Vehículos</span> que Atendemos
        </h1>
        <p class="text-lg text-gray-400 max-w-3xl mx-auto">
          Catálogo completo con todos los vehículos que atendemos con servicio mecánico a domicilio en Santiago. Cada vehículo tiene su propia landing con fotografía real, lista de servicios disponibles, información técnica específica y botón directo de cotización por WhatsApp.
        </p>
      </div>

      <!-- Filtros por marca -->
      <div class="flex flex-wrap justify-center gap-2 mb-10">
        <button data-marca="todos" class="filtro-marca active px-4 py-2 rounded-lg text-sm font-medium border-2 border-neon-500 bg-neon-500 text-dark-500 transition-all">
          Todos
        </button>
        {marcas.map(m => (
          <button data-marca={m.slug} class="filtro-marca px-4 py-2 rounded-lg text-sm font-medium border-2 border-neon-500/30 text-gray-300 hover:bg-neon-500 hover:text-dark-500 hover:border-neon-500 transition-all">
            {m.nombre} ({m.modelos.length})
          </button>
        ))}
      </div>

      <!-- Grid de TODOS los vehículos -->
      <div id="grid-vehiculos" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {vehiculos.map(v => {
          const prefix = v.marcaSlug + '-';
          const modeloSlug = v.slug.startsWith(prefix) ? v.slug.slice(prefix.length) : v.slug;
          return (
            <a
              href={`/vehiculos/${v.marcaSlug}/${modeloSlug}`}
              data-marca-item={v.marcaSlug}
              class="group relative card-neon overflow-hidden"
            >
              <div class="aspect-4/3 overflow-hidden rounded-lg mb-3 bg-dark-100 relative">
                <img
                  src={v.imagen}
                  alt={v.alt}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-dark-400/80 via-transparent to-transparent opacity-60 group-hover:opacity-80 transition-opacity"></div>
                <div class="absolute top-2 left-2 px-2 py-1 bg-dark-300/80 backdrop-blur rounded text-[10px] text-neon-400 uppercase tracking-wide border border-neon-500/30">
                  {v.marca}
                </div>
                {v.tipo && (
                  <div class="absolute top-2 right-2 px-2 py-1 bg-dark-300/80 backdrop-blur rounded text-[10px] text-gray-300 uppercase tracking-wide border border-neon-500/20">
                    {v.tipo}
                  </div>
                )}
              </div>
              <div class="px-1">
                <h3 class="text-base font-display font-bold text-white group-hover:text-neon-400 transition-colors mb-1">
                  {v.marca} {v.modelo}
                </h3>
                <div class="flex items-center justify-between text-xs text-gray-400">
                  <span>Ver servicios</span>
                  <svg class="w-4 h-4 text-neon-500/40 group-hover:text-neon-400 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <!-- Empty state -->
      <div id="no-results" class="hidden text-center py-20">
        <div class="text-6xl mb-4">🚗</div>
        <h3 class="text-xl font-display font-bold text-white mb-2">No hay vehículos en esta categoría</h3>
        <p class="text-gray-400 mb-6">Prueba con otra marca o consulta por WhatsApp.</p>
        <button id="reset-filtro" class="btn-outline-neon text-sm">Ver todos los vehículos</button>
      </div>

      <!-- CTA inferior -->
      <div class="text-center mt-16">
        <div class="card-neon max-w-2xl mx-auto">
          <h3 class="text-xl font-display font-bold text-white mb-3">¿Tu vehículo no aparece en la lista?</h3>
          <p class="text-gray-400 mb-6">
            Aunque no esté listado aquí, es muy probable que también lo atendamos. Escríbenos por WhatsApp con marca y modelo para confirmar cobertura.
          </p>
          <a href={waLink('Hola, ¿atienden mi vehículo en Santiago?')} target="_blank" rel="noopener" class="btn-whatsapp">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Consultar mi vehículo
          </a>
        </div>
      </div>

      <!-- Navegación interna -->
      <div class="text-center mt-8">
        <a href="/vehiculos" class="text-sm text-neon-400 hover:underline inline-flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Ver vehículos agrupados por marca
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Filtro por marca
  const botones = document.querySelectorAll('.filtro-marca');
  const items = document.querySelectorAll('[data-marca-item]');
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-filtro');

  botones.forEach(btn => {
    btn.addEventListener('click', () => {
      const marca = btn.getAttribute('data-marca');

      // Actualizar botones activos
      botones.forEach(b => {
        b.classList.remove('bg-neon-500', 'text-dark-500', 'border-neon-500');
        b.classList.add('text-gray-300', 'border-neon-500/30');
      });
      btn.classList.add('bg-neon-500', 'text-dark-500', 'border-neon-500');
      btn.classList.remove('text-gray-300', 'border-neon-500/30');

      // Filtrar items
      let visibleCount = 0;
      items.forEach(item => {
        const itemMarca = item.getAttribute('data-marca-item');
        if (marca === 'todos' || itemMarca === marca) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      // Mostrar/ocultar empty state
      if (visibleCount === 0) {
        noResults?.classList.remove('hidden');
      } else {
        noResults?.classList.add('hidden');
      }
    });
  });

  resetBtn?.addEventListener('click', () => {
    const todosBtn = document.querySelector('[data-marca="todos"]') as HTMLElement;
    todosBtn?.click();
  });
</script>
