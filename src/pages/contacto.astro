---
import BaseLayout from '@/layouts/BaseLayout.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import { config, waLink } from '@/data/config';
---

<BaseLayout
  title="Contacto | DRAUTOMOTRIZ - Mecánico a Domicilio en Santiago"
  description="Contacta con DRAUTOMOTRIZ para servicio mecánico a domicilio en Santiago. WhatsApp +56962408735, formulario de cotización y atención 24/7 en toda la Región Metropolitana."
  canonical="/contacto"
>
  <section class="pt-16 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl"></div>

    <div class="container-x relative">
      <nav class="flex items-center gap-2 text-xs text-gray-500 mb-8">
        <a href="/" class="hover:text-neon-400 transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-neon-400">Contacto</span>
      </nav>

      <div class="text-center mb-12">
        <span class="badge-neon mb-4">Contacto</span>
        <h1 class="text-4xl md:text-5xl font-display font-extrabold text-white mb-6 text-balance">
          Contáctanos
        </h1>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">
          Escríbenos por WhatsApp para respuesta inmediata o completa el formulario de cotización. Atendemos 24/7 en toda la Región Metropolitana.
        </p>
      </div>

      <!-- Quick contact methods -->
      <div class="grid md:grid-cols-3 gap-6 mb-16 max-w-4xl mx-auto">
        <!-- WhatsApp -->
        <a href={waLink()} target="_blank" rel="noopener" class="card-neon text-center group">
          <div class="w-14 h-14 mx-auto rounded-full bg-[#25D366]/10 border border-[#25D366]/30 flex items-center justify-center mb-4 group-hover:shadow-[0_0_30px_rgba(37,211,102,0.5)] transition-shadow">
            <svg class="w-7 h-7 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-white mb-2">WhatsApp</h3>
          <p class="text-sm text-gray-400 mb-3">Respuesta en 5-15 min</p>
          <p class="text-neon-400 font-semibold">+569 6240 8735</p>
        </a>

        <!-- Instagram -->
        <a href={config.instagramUrl} target="_blank" rel="noopener" class="card-neon text-center group">
          <div class="w-14 h-14 mx-auto rounded-full bg-neon-500/10 border border-neon-500/30 flex items-center justify-center mb-4 group-hover:shadow-neon transition-shadow">
            <svg class="w-7 h-7 text-neon-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-white mb-2">Instagram</h3>
          <p class="text-sm text-gray-400 mb-3">Nuestros trabajos</p>
          <p class="text-neon-400 font-semibold">{config.instagram}</p>
        </a>

        <!-- Cobertura -->
        <a href="/comunas" class="card-neon text-center group">
          <div class="w-14 h-14 mx-auto rounded-full bg-neon-500/10 border border-neon-500/30 flex items-center justify-center mb-4 group-hover:shadow-neon transition-shadow">
            <svg class="w-7 h-7 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-white mb-2">Cobertura</h3>
          <p class="text-sm text-gray-400 mb-3">40+ comunas RM</p>
          <p class="text-neon-400 font-semibold">Ver comunas</p>
        </a>
      </div>

      <!-- Quote form -->
      <QuoteForm />

      <!-- Mapa de cobertura simplificado -->
      <div class="mt-16 max-w-4xl mx-auto card-neon">
        <h3 class="text-xl font-display font-bold text-white mb-4">Información de contacto</h3>
        <div class="grid sm:grid-cols-2 gap-4 text-sm">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-neon-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <div>
              <div class="text-white font-semibold">Zona de servicio</div>
              <div class="text-gray-400">Santiago, Región Metropolitana</div>
              <div class="text-gray-400">Cobertura en 40+ comunas</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-neon-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <div class="text-white font-semibold">Horario</div>
              <div class="text-gray-400">{config.horario}</div>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-neon-400 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <div>
              <div class="text-white font-semibold">WhatsApp</div>
              <a href={waLink()} target="_blank" rel="noopener" class="text-neon-400 hover:underline">+569 6240 8735</a>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-neon-400 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <div>
              <div class="text-white font-semibold">Instagram</div>
              <a href={config.instagramUrl} target="_blank" rel="noopener" class="text-neon-400 hover:underline">{config.instagram}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
