---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { servicios } from '@/data/servicios';
import { waLink } from '@/data/config';
import fs from 'node:fs';
import path from 'node:path';

// Leer todas las imágenes de /public/imagen/drautomotriz/
const galeriaDir = path.join(process.cwd(), 'public', 'imagen', 'drautomotriz');
let todasImagenes: string[] = [];
try {
  const allDrautomotriz = fs.readdirSync(galeriaDir)
    .filter(f => /\.(jpg|jpeg|png|webp)$/i.test(f));
  // Solo WebP, excluir PNG/JPEG duplicados
  const webpBases = new Set(allDrautomotriz.filter(f => f.endsWith('.webp')).map(f => f.replace(/\.webp$/i, '')));
  todasImagenes = allDrautomotriz
    .filter(f => {
      if (f.endsWith('.webp')) return true;
      const base = f.replace(/\.(jpg|jpeg|png)$/i, '');
      return !webpBases.has(base);
    })
    .map(f => `/imagen/drautomotriz/${f}`)
    .sort();
} catch (e) {
  console.warn('No se pudo leer directorio galeria:', e);
}

// También incluir las fotos temáticas de /public/imagen/galeria/
const galeriaExtraDir = path.join(process.cwd(), 'public', 'imagen', 'galeria');
let imagenesExtra: string[] = [];
try {
  imagenesExtra = fs.readdirSync(galeriaExtraDir)
    .filter(f => /\.(jpg|jpeg|png|webp)$/i.test(f))
    .map(f => `/imagen/galeria/${f}`)
    .sort();
} catch (e) {
  console.warn('No se pudo leer directorio galeria extra:', e);
}

// Y banners
const bannerDir = path.join(process.cwd(), 'public', 'imagen', 'banner');
let imagenesBanner: string[] = [];
try {
  imagenesBanner = fs.readdirSync(bannerDir)
    .filter(f => /\.(jpg|jpeg|png|webp)$/i.test(f))
    .map(f => `/imagen/banner/${f}`)
    .sort();
} catch (e) {
  console.warn('No se pudo leer directorio banner:', e);
}

const todasLasImagenes = [...todasImagenes, ...imagenesExtra, ...imagenesBanner];
const totalImagenes = todasLasImagenes.length;

// Schema.org ImageGallery
const gallerySchema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "Galería de Trabajos DRAUTOMOTRIZ",
  "description": `Galería con ${totalImagenes} fotos de trabajos mecánicos a domicilio realizados por DRAUTOMOTRIZ en Santiago, Chile.`,
  "url": "https://drautomotriz.pages.dev/galeria",
  "image": todasLasImagenes.slice(0, 20).map(src => ({
    "@type": "ImageObject",
    "url": `https://drautomotriz.pages.dev${src}`,
    "contentUrl": `https://drautomotriz.pages.dev${src}`
  }))
};

// Categorías para filtro (basadas en servicios)
const categorias = [
  { id: 'todos', nombre: 'Todas', icono: '🖼️' },
  { id: 'mecanica', nombre: 'Mecánica General', icono: '🔧' },
  { id: 'frenos', nombre: 'Frenos', icono: '🛑' },
  { id: 'motor', nombre: 'Motor', icono: '⚙️' },
  { id: 'suspension', nombre: 'Suspensión', icono: '🚗' },
  { id: 'vehiculo', nombre: 'Vehículos', icono: '🚙' },
  { id: 'taller', nombre: 'Taller', icono: '🏭' },
  { id: 'revision', nombre: 'Revisión Técnica', icono: '📋' },
];
---

<BaseLayout
  title={`Galería de Trabajos | ${totalImagenes} Fotos | DRAUTOMOTRIZ - Mecánico a Domicilio en Santiago`}
  description={`Galería con ${totalImagenes} fotos de trabajos mecánicos a domicilio realizados por DRAUTOMOTRIZ en Santiago. Mira ejemplos de nuestros servicios de mecánica, frenos, motor, suspensión y más.`}
  canonical="/galeria"
>
  <script type="application/ld+json" set:html={JSON.stringify(gallerySchema)} />

  <section class="pt-16 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl"></div>

    <div class="container-x relative">
      <nav class="flex items-center gap-2 text-xs text-gray-500 mb-8">
        <a href="/" class="hover:text-neon-400 transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-neon-400">Galería</span>
      </nav>

      <div class="text-center mb-12">
        <span class="badge-neon mb-4">Galería</span>
        <h1 class="text-4xl md:text-5xl font-display font-extrabold text-white mb-6 text-balance">
          Galería de <span class="text-transparent bg-clip-text bg-gradient-neon glow-text">Trabajos</span>
        </h1>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">
          {totalImagenes} fotos de trabajos mecánicos a domicilio realizados por DRAUTOMOTRIZ en distintas comunas de Santiago. Explora nuestra galería para ver ejemplos de los servicios que ofrecemos.
        </p>
      </div>

      <!-- Filtros por categoría -->
      <div class="flex flex-wrap justify-center gap-2 mb-10">
        {categorias.map(cat => (
          <button
            type="button"
            data-categoria={cat.id}
            class="px-4 py-2 rounded-lg text-sm font-medium border border-neon-500/30 text-gray-300 hover:bg-neon-500 hover:text-dark-500 hover:border-neon-500 transition-all categoria-btn"
          >
            <span class="mr-1">{cat.icono}</span>
            {cat.nombre}
          </button>
        ))}
      </div>

      <!-- Grid de fotos -->
      <div id="grid-galeria" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {todasLasImagenes.map((src, i) => {
          // Determinar categoría basada en el nombre del archivo
          const filename = src.split('/').pop() || '';
          let categoria = 'todos';
          if (filename.includes('frenos')) categoria = 'frenos';
          else if (filename.includes('motor')) categoria = 'motor';
          else if (filename.includes('suspension') || filename.includes('neumatico')) categoria = 'suspension';
          else if (filename.includes('vehiculo') || filename.includes('drautomotriz-chevrolet') || filename.includes('drautomotriz-toyota') || filename.includes('drautomotriz-hyundai') || filename.includes('drautomotriz-kia') || filename.includes('drautomotriz-mazda') || filename.includes('drautomotriz-honda') || filename.includes('drautomotriz-ford') || filename.includes('drautomotriz-peugeot') || filename.includes('drautomotriz-renault') || filename.includes('drautomotriz-subaru') || filename.includes('drautomotriz-suzuki') || filename.includes('drautomotriz-volkswagen') || filename.includes('drautomotriz-nissan')) categoria = 'vehiculo';
          else if (filename.includes('taller') || filename.includes('logo')) categoria = 'taller';
          else if (filename.includes('revision')) categoria = 'revision';
          else if (filename.includes('mecanica') || filename.includes('bomba') || filename.includes('aceite') || filename.includes('filtro')) categoria = 'mecanica';

          // Generar alt descriptivo
          const alt = filename
            .replace(/\.(jpg|jpeg|png|webp)$/i, '')
            .replace(/-/g, ' ')
            .replace(/\b\w/g, c => c.toUpperCase());

          return (
            <div
              data-item-categoria={categoria}
              class="group relative aspect-square rounded-xl overflow-hidden border border-neon-500/20 hover:border-neon-500/60 transition-all cursor-pointer"
              data-src={src}
              data-alt={alt}
            >
              <img
                src={src}
                alt={alt}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-dark-400/95 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-3">
                <div>
                  <div class="text-xs text-neon-400 uppercase tracking-wide mb-1">{categoria}</div>
                  <div class="text-sm font-display font-bold text-white line-clamp-2">{alt}</div>
                </div>
              </div>
              <div class="absolute top-2 right-2 px-2 py-1 bg-dark-300/80 backdrop-blur rounded text-[10px] text-neon-400 uppercase tracking-wide border border-neon-500/30 opacity-0 group-hover:opacity-100 transition-opacity">
                {categoria}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Empty state si no hay imágenes -->
      {totalImagenes === 0 && (
        <div class="text-center py-20">
          <div class="text-6xl mb-4">📷</div>
          <h3 class="text-xl font-display font-bold text-white mb-2">No hay fotos disponibles</h3>
          <p class="text-gray-400 mb-6">Las fotos se subirán próximamente.</p>
          <a href={waLink('Hola, quiero ver ejemplos de trabajos')} target="_blank" rel="noopener" class="btn-whatsapp">
            Solicitar ejemplos por WhatsApp
          </a>
        </div>
      )}

      <!-- CTA inferior -->
      <div class="text-center mt-12">
        <p class="text-sm text-gray-500 mb-4">
          ¿Quieres ver más trabajos o tienes preguntas sobre un servicio específico?
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={waLink('Hola, quiero ver ejemplos de trabajos')} target="_blank" rel="noopener" class="btn-whatsapp text-sm">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Solicitar ejemplos
          </a>
          <a href="/servicios" class="btn-outline-neon text-sm">Ver servicios</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Lightbox modal -->
  <div id="lightbox" class="fixed inset-0 z-[100] bg-dark-500/95 backdrop-blur-md hidden items-center justify-center p-4">
    <button id="lightbox-close" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-dark-200 border border-neon-500/40 text-neon-400 hover:bg-neon-500 hover:text-dark-500 flex items-center justify-center transition-all">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
    <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-dark-200 border border-neon-500/40 text-neon-400 hover:bg-neon-500 hover:text-dark-500 flex items-center justify-center transition-all">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>
    <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-dark-200 border border-neon-500/40 text-neon-400 hover:bg-neon-500 hover:text-dark-500 flex items-center justify-center transition-all">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </button>
    <div class="max-w-5xl max-h-[85vh] w-full">
      <img id="lightbox-img" src="" alt="" class="w-full h-full object-contain rounded-lg" />
      <div id="lightbox-caption" class="text-center text-sm text-gray-400 mt-3"></div>
    </div>
  </div>
</BaseLayout>

<script>
  // Filtro por categoría
  const botones = document.querySelectorAll('.categoria-btn');
  const items = document.querySelectorAll('[data-item-categoria]');

  botones.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-categoria');

      // Actualizar botones activos
      botones.forEach(b => {
        b.classList.remove('bg-neon-500', 'text-dark-500', 'border-neon-500');
        b.classList.add('text-gray-300', 'border-neon-500/30');
      });
      btn.classList.add('bg-neon-500', 'text-dark-500', 'border-neon-500');
      btn.classList.remove('text-gray-300', 'border-neon-500/30');

      // Filtrar items
      items.forEach(item => {
        const itemCat = item.getAttribute('data-item-categoria');
        if (cat === 'todos' || itemCat === cat) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });

  // Lightbox
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');

  let currentImages: { src: string; alt: string }[] = [];
  let currentIndex = 0;

  function openLightbox(src: string, alt: string) {
    // Construir lista de imágenes visibles actualmente
    currentImages = [];
    items.forEach(item => {
      if (item instanceof HTMLElement && item.style.display !== 'none') {
        const itemSrc = item.getAttribute('data-src');
        const itemAlt = item.getAttribute('data-alt');
        if (itemSrc) {
          currentImages.push({ src: itemSrc, alt: itemAlt || '' });
          if (itemSrc === src) {
            currentIndex = currentImages.length - 1;
          }
        }
      }
    });

    showImage();
    lightbox?.classList.remove('hidden');
    lightbox?.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function showImage() {
    if (currentImages.length === 0) return;
    const img = currentImages[currentIndex];
    if (lightboxImg) {
      lightboxImg.setAttribute('src', img.src);
      lightboxImg.setAttribute('alt', img.alt);
    }
    if (lightboxCaption) {
      lightboxCaption.textContent = `${currentIndex + 1} / ${currentImages.length} - ${img.alt}`;
    }
  }

  function closeLightbox() {
    lightbox?.classList.add('hidden');
    lightbox?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function nextImage() {
    currentIndex = (currentIndex + 1) % currentImages.length;
    showImage();
  }

  function prevImage() {
    currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
    showImage();
  }

  items.forEach(item => {
    item.addEventListener('click', () => {
      const src = item.getAttribute('data-src');
      const alt = item.getAttribute('data-alt');
      if (src) openLightbox(src, alt || '');
    });
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxNext?.addEventListener('click', nextImage);
  lightboxPrev?.addEventListener('click', prevImage);

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox?.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowRight') nextImage();
    if (e.key === 'ArrowLeft') prevImage();
  });
</script>
