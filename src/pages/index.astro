---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import RevisionTecnicaHighlight from '@/components/RevisionTecnicaHighlight.astro';
import Services from '@/components/Services.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import Vehiculos from '@/components/Vehiculos.astro';
import ComunasHighlight from '@/components/ComunasHighlight.astro';
import Gallery from '@/components/Gallery.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import CotizacionBanner from '@/components/CotizacionBanner.astro';
import { config, waLink } from '@/data/config';
import { servicios } from '@/data/servicios';
import { marcas, totalModelos } from '@/data/marcas';
import { comunas } from '@/data/comunas';

// Schema.org para la home
const homeSchema = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  "name": "DRAUTOMOTRIZ",
  "alternateName": "DRAUTOMOTRIZ - Mecánico a Domicilio",
  "description": "Servicio mecánico a domicilio en Santiago, Chile. Diagnóstico, mantención, frenos, batería, suspensión, revisión técnica sin estrés y auxilio 24/7.",
  "url": "https://drautomotriz.pages.dev/",
  "logo": "https://drautomotriz.pages.dev/imagen/logo/drautomotriz-logo.webp",
  "image": "https://drautomotriz.pages.dev/og-image.png",
  "telephone": "+56962408735",
  "email": "contacto@drautomotriz.cl",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Santiago",
    "addressRegion": "Región Metropolitana",
    "addressCountry": "CL"
  },
  "areaServed": [
    {"@type": "City", "name": "Santiago"},
    {"@type": "AdministrativeArea", "name": "Región Metropolitana"}
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
      "opens": "08:00",
      "closes": "20:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  ],
  "sameAs": [
    "https://instagram.com/dr_automotrizz",
    "https://github.com/bboymak3/drautomotriz-web"
  ]
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
  <Hero />

  <!-- Sección descriptiva ampliada -->
  <section class="py-16 relative overflow-hidden">
    <div class="container-x relative">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <span class="badge-neon mb-4">Sobre DRAUTOMOTRIZ</span>
          <h2 class="text-3xl md:text-4xl font-display font-bold text-white mb-6">
            Mecánico a Domicilio <span class="text-transparent bg-clip-text bg-gradient-neon glow-text">en Santiago, Chile</span>
          </h2>
        </div>

        <div class="space-y-6 text-gray-300 leading-relaxed text-lg">
          <p>
            <strong class="text-white">DRAUTOMOTRIZ</strong> es el servicio de mecánica automotriz a domicilio líder en Santiago, Chile. Llevamos el taller mecánico directamente hasta tu casa, oficina o estacionamiento, eliminando la necesidad de trasladar tu vehículo, esperar en filas de taller, o perder horas valiosas de tu día. Nuestro modelo de servicio móvil cubre toda la Región Metropolitana con más de 40 comunas atendidas, desde Las Condes y Providencia hasta Maipú, La Florida, Puente Alto y San Bernardo.
          </p>
          <p>
            Contamos con un equipo de mecánicos certificados con más de 8 años de experiencia, equipamiento profesional de diagnóstico computarizado multimarca, y repuestos OEM de calidad de marcas reconocidas como Bosch, Mann, Gates, Mobil, Castrol, KYB, Monroe y TRW. Atendemos todos los tipos de vehículos: autos livianos, SUVs, camionetas, vans comerciales y vehículos pesados. Actualmente damos cobertura a <strong class="text-neon-400">{totalModelos}+ modelos</strong> de <strong class="text-neon-400">{marcas.length} marcas</strong> distintas, incluyendo Chevrolet, Toyota, Hyundai, Kia, Nissan, Mazda, Honda, Ford, Suzuki, Peugeot, Renault, Subaru y Volkswagen.
          </p>
          <p>
            Nuestro catálogo de servicios incluye <strong class="text-white">{servicios.length} servicios especializados</strong>: mantención por kilometraje, escáner y diagnóstico computarizado, frenos a domicilio, tren delantero, dirección y suspensión, cambio de kit de distribución, kit de embrague, recarga de aire acondicionado, pulido de ópticos, venta de aceites motor, diagnóstico de pre-compra, y el servicio estrella de <strong class="text-orange-400">Revisión Técnica Sin Estrés</strong> donde retiramos tu auto, lo llevamos a la planta oficial, y te lo devolvemos con el documento aprobado.
          </p>
          <p>
            Lo que nos diferencia de los talleres tradicionales es nuestro compromiso con la transparencia y la calidad: antes de cualquier trabajo te entregamos un presupuesto cerrado sin costos ocultos, todos nuestros servicios incluyen garantía escrita de 3 a 12 meses, trabajamos exclusivamente con repuestos de calidad OEM, y entregamos boleta electrónica. Además, nuestro tiempo promedio de respuesta en Santiago es de <strong class="text-neon-400">45 a 60 minutos</strong> desde tu solicitud por WhatsApp, con atención disponible 24/7 los 365 días del año para emergencias y auxilio mecánico.
          </p>
        </div>

        <!-- CTA -->
        <div class="mt-10 text-center">
          <a href={waLink()} target="_blank" rel="noopener" class="btn-whatsapp">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Agenda tu servicio ahora
          </a>
        </div>
      </div>
    </div>
  </section>

  <RevisionTecnicaHighlight />
  <Services />
  <Vehiculos />
  <HowItWorks />
  <ComunasHighlight />
  <CotizacionBanner />
  <Gallery />
  <QuoteForm />
</BaseLayout>
