---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import BannerMidSize from '@/components/BannerMidSize.astro';
import SeoTextBlock from '@/components/SeoTextBlock.astro';
import RevisionTecnicaHighlight from '@/components/RevisionTecnicaHighlight.astro';
import Services from '@/components/Services.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import Vehiculos from '@/components/Vehiculos.astro';
import ComunasHighlight from '@/components/ComunasHighlight.astro';
import Gallery from '@/components/Gallery.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import CotizacionBanner from '@/components/CotizacionBanner.astro';
import { config, waLink } from '@/data/config';
import { servicios } from '@/data/servicios';
import { marcas, totalVehiculos } from '@/data/marcas';
import { comunas } from '@/data/comunas';

// Schema.org para la home
const homeSchema = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  "name": "DRAUTOMOTRIZ",
  "alternateName": "DRAUTOMOTRIZ - Mecánico a Domicilio",
  "description": "Servicio mecánico a domicilio en Santiago, Chile. Diagnóstico, mantención, frenos, batería, suspensión, revisión técnica sin estrés y auxilio 24/7.",
  "url": "https://drmecanicoautomotriz.com/",
  "logo": "https://drmecanicoautomotriz.com/imagen/logo/drautomotriz-logo.webp",
  "image": "https://drmecanicoautomotriz.com/og-image.png",
  "telephone": "+56962408735",
  "email": "contacto@drautomotriz.cl",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Santiago",
    "addressRegion": "Región Metropolitana",
    "addressCountry": "CL"
  },
  "areaServed": [
    {"@type": "City", "name": "Santiago"},
    {"@type": "AdministrativeArea", "name": "Región Metropolitana"}
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
      "opens": "08:00",
      "closes": "20:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  ],
  "sameAs": [
    "https://instagram.com/dr_automotrizz",
    "https://github.com/bboymak3/drautomotriz-web"
  ]
};
---

<BaseLayout skipBreadcrumb={true} skipAutoRepair={true}>
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://drmecanicoautomotriz.com/" }
    ]
  })} />

  <!-- HERO FULL-WIDTH CON BANNER -->
  <Hero />

  <!-- Banner mediano (50% ancho) con revision-tecnica-sin-estres -->
  <BannerMidSize />

  <!-- TEXTO SEO 1: Sección Principal (después del Hero) -->
  <SeoTextBlock variante="texto1" />

  <!-- Servicio Estrella: Revisión Técnica Sin Estrés -->
  <RevisionTecnicaHighlight />

  <!-- TEXTO SEO 2: Servicios y Especialidades (antes del grid de servicios) -->
  <SeoTextBlock variante="texto2" />

  <!-- Grid de Servicios -->
  <Services />

  <!-- ====== MANTENCIÓN PRE COMPRA ====== -->
  <section class="py-16 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-10"></div>
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-neon-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-x relative">
      <div class="text-center mb-12">
        <span class="badge-neon mb-4">🔍 Inspección Profesional</span>
        <h2 class="text-3xl md:text-4xl font-display font-extrabold text-white mb-4">
          Mantención <span class="text-transparent bg-clip-text bg-gradient-neon glow-text">Pre Compra</span>
        </h2>
        <p class="text-gray-400 max-w-2xl mx-auto text-sm sm:text-base leading-relaxed">
          Inspección técnica completa antes de comprar un auto usado y mantenciones preventivas que alargan la vida útil de tu vehículo. Evita malas compras y sorpresas costosas con un diagnóstico profesional a domicilio.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto mb-10">
        <!-- Pre Compra -->
        <div class="neon-card rounded-2xl overflow-hidden flex flex-col">
          <img src="/imagen/drautomotriz/drautomotriz-pre-compra-inspeccion-auto-f2c530f4.webp" alt="Inspección pre compra de auto usado en Santiago - DRAUTOMOTRIZ" class="w-full h-56 object-cover" loading="lazy" width="640" height="280" />
          <div class="p-6 flex flex-col flex-1">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 flex items-center justify-center rounded-xl bg-neon-500/10 border border-neon-500/20 shrink-0">
                <span class="text-xl">🔍</span>
              </div>
              <h3 class="text-lg font-display font-bold text-white">Servicio de Pre-Compra</h3>
            </div>
            <p class="text-sm text-gray-400 leading-relaxed mb-5 flex-1">Inspección técnica completa de 150+ puntos antes de comprar un auto usado. Escáner computarizado, revisión de motor, transmisión, frenos, suspensión, carrocería y documentos. Informe PDF con fotos y calificación final.</p>
            <div class="flex flex-wrap gap-2">
              <a href="/servicios/servicio-de-pre-compra" class="btn-neon text-xs py-2 px-4">Ver servicio</a>
              <a href={waLink('Hola! Quiero cotizar una inspección pre compra de auto usado')} target="_blank" rel="noopener" class="btn-outline-neon text-xs py-2 px-4">Cotizar</a>
            </div>
          </div>
        </div>

        <!-- Mantención Preventiva -->
        <div class="neon-card rounded-2xl overflow-hidden flex flex-col">
          <img src="/imagen/drautomotriz/drautomotriz-mantencion-preventiva-auto-40b628be.webp" alt="Mantención preventiva automotriz a domicilio en Santiago - DRAUTOMOTRIZ" class="w-full h-56 object-cover" loading="lazy" width="640" height="280" />
          <div class="p-6 flex flex-col flex-1">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 flex items-center justify-center rounded-xl bg-neon-500/10 border border-neon-500/20 shrink-0">
                <span class="text-xl">📊</span>
              </div>
              <h3 class="text-lg font-display font-bold text-white">Mantención Preventiva</h3>
            </div>
            <p class="text-sm text-gray-400 leading-relaxed mb-5 flex-1">Mantenciones programadas según kilometraje (10k, 20k, 40k, 60k, 100k km) con repuestos OEM premium. Informe detallado y recordatorio automático para tu próxima mantención. Todo a domicilio.</p>
            <div class="flex flex-wrap gap-2">
              <a href="/servicios/mantencion-por-km" class="btn-neon text-xs py-2 px-4">Ver servicio</a>
              <a href={waLink('Hola! Quiero cotizar una mantención preventiva')} target="_blank" rel="noopener" class="btn-outline-neon text-xs py-2 px-4">Cotizar</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Galería de fotos de inspección -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-5xl mx-auto">
        <img src="/imagen/drautomotriz/drautomotriz-mantencion-preventiva-auto-40b628be.webp" alt="Mantención preventiva de auto en Santiago" class="w-full aspect-square object-cover rounded-xl border border-neon-500/20" loading="lazy" />
        <img src="/imagen/drautomotriz/drautomotriz-mantencion-preventiva-auto-a5a67ace.webp" alt="Inspección preventiva automotriz" class="w-full aspect-square object-cover rounded-xl border border-neon-500/20" loading="lazy" />
        <img src="/imagen/drautomotriz/drautomotriz-pre-compra-inspeccion-auto-f2c530f4.webp" alt="Inspección pre compra de vehículo" class="w-full aspect-square object-cover rounded-xl border border-neon-500/20" loading="lazy" />
        <img src="/imagen/drautomotriz/drautomotriz-mantencion-automotriz-ahorro-bencina-rendimiento.webp" alt="Mantención automotriz ahorro bencina" class="w-full aspect-square object-cover rounded-xl border border-neon-500/20" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Banner asistencia-automotriz antes de vehículos -->
  <section class="py-8 md:py-12 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-10"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[600px] bg-neon-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-x relative">
      <div class="relative max-w-6xl mx-auto w-full">
        <!-- Glow detrás -->
        <div class="absolute -inset-3 rounded-2xl bg-gradient-neon opacity-20 blur-2xl"></div>

        <!-- Imagen del banner -->
        <div class="relative aspect-[1915/821] rounded-2xl overflow-hidden border-2 border-neon-500/40 shadow-neon-lg">
          <img
            src="/imagen/banner/asistencia-automotriz.webp"
            alt="Asistencia Automotriz a Domicilio en Santiago - DRAUTOMOTRIZ servicio mecánico móvil 24/7 en toda la Región Metropolitana"
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <!-- Degradado superior sutil -->
          <div class="absolute inset-x-0 top-0 h-12 md:h-16 bg-gradient-to-b from-dark-400/40 to-transparent"></div>
          <!-- Degradado inferior pronunciado -->
          <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-dark-400/95 via-dark-400/60 to-transparent"></div>
          <!-- Texto inferior -->
          <div class="absolute bottom-3 left-3 right-3 md:bottom-5 md:left-5 md:right-5">
            <div class="text-xs md:text-sm text-neon-400 uppercase tracking-wider mb-1 font-semibold">Asistencia Automotriz 24/7</div>
            <div class="text-white font-display font-bold text-sm md:text-lg lg:text-xl leading-tight">
              Servicio mecánico móvil en toda la Región Metropolitana
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vehículos que atendemos -->
  <Vehiculos />

  <!-- Cómo funciona -->
  <HowItWorks />

  <!-- Comunas -->
  <ComunasHighlight />

  <!-- Banner de Cotización -->
  <CotizacionBanner />

  <!-- Galería de trabajos -->
  <Gallery />

  <!-- TEXTO SEO 3: Cierre y CTA (antes del formulario) -->
  <SeoTextBlock variante="texto3" />

  <!-- Formulario de cotización -->
  <QuoteForm />
</BaseLayout>
<!-- cache-bust-v2 -->
<!-- cache-bust-v3 -->
