---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import BannerMidSize from '@/components/BannerMidSize.astro';
import SeoTextBlock from '@/components/SeoTextBlock.astro';
import RevisionTecnicaHighlight from '@/components/RevisionTecnicaHighlight.astro';
import Services from '@/components/Services.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import Vehiculos from '@/components/Vehiculos.astro';
import ComunasHighlight from '@/components/ComunasHighlight.astro';
import Gallery from '@/components/Gallery.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import CotizacionBanner from '@/components/CotizacionBanner.astro';
import { config, waLink } from '@/data/config';
import { servicios } from '@/data/servicios';
import { marcas, totalVehiculos } from '@/data/marcas';
import { comunas } from '@/data/comunas';

// Schema.org para la home
const homeSchema = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  "name": "DRAUTOMOTRIZ",
  "alternateName": "DRAUTOMOTRIZ - Mecánico a Domicilio",
  "description": "Servicio mecánico a domicilio en Santiago, Chile. Diagnóstico, mantención, frenos, batería, suspensión, revisión técnica sin estrés y auxilio 24/7.",
  "url": "https://drautomotriz.pages.dev/",
  "logo": "https://drautomotriz.pages.dev/imagen/logo/drautomotriz-logo.webp",
  "image": "https://drautomotriz.pages.dev/og-image.png",
  "telephone": "+56962408735",
  "email": "contacto@drautomotriz.cl",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Santiago",
    "addressRegion": "Región Metropolitana",
    "addressCountry": "CL"
  },
  "areaServed": [
    {"@type": "City", "name": "Santiago"},
    {"@type": "AdministrativeArea", "name": "Región Metropolitana"}
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
      "opens": "08:00",
      "closes": "20:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  ],
  "sameAs": [
    "https://instagram.com/dr_automotrizz",
    "https://github.com/bboymak3/drautomotriz-web"
  ]
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />

  <!-- HERO FULL-WIDTH CON BANNER -->
  <Hero />

  <!-- Banner mediano (50% ancho) con revision-tecnica-sin-estres -->
  <BannerMidSize />

  <!-- TEXTO SEO 1: Sección Principal (después del Hero) -->
  <SeoTextBlock variante="texto1" />

  <!-- Servicio Estrella: Revisión Técnica Sin Estrés -->
  <RevisionTecnicaHighlight />

  <!-- TEXTO SEO 2: Servicios y Especialidades (antes del grid de servicios) -->
  <SeoTextBlock variante="texto2" />

  <!-- Grid de Servicios -->
  <Services />

  <!-- Banner asistencia-automotriz antes de vehículos -->
  <section class="py-8 md:py-12 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-10"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[600px] bg-neon-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-x relative">
      <div class="relative max-w-6xl mx-auto w-full">
        <!-- Glow detrás -->
        <div class="absolute -inset-3 rounded-2xl bg-gradient-neon opacity-20 blur-2xl"></div>

        <!-- Imagen del banner -->
        <div class="relative aspect-[1915/821] rounded-2xl overflow-hidden border-2 border-neon-500/40 shadow-neon-lg">
          <img
            src="/imagen/banner/asistencia-automotriz.png"
            alt="Asistencia Automotriz a Domicilio en Santiago - DRAUTOMOTRIZ servicio mecánico móvil 24/7 en toda la Región Metropolitana"
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <!-- Degradado superior sutil -->
          <div class="absolute inset-x-0 top-0 h-12 md:h-16 bg-gradient-to-b from-dark-400/40 to-transparent"></div>
          <!-- Degradado inferior pronunciado -->
          <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-dark-400/95 via-dark-400/60 to-transparent"></div>
          <!-- Texto inferior -->
          <div class="absolute bottom-3 left-3 right-3 md:bottom-5 md:left-5 md:right-5">
            <div class="text-xs md:text-sm text-neon-400 uppercase tracking-wider mb-1 font-semibold">Asistencia Automotriz 24/7</div>
            <div class="text-white font-display font-bold text-sm md:text-lg lg:text-xl leading-tight">
              Servicio mecánico móvil en toda la Región Metropolitana
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vehículos que atendemos -->
  <Vehiculos />

  <!-- Cómo funciona -->
  <HowItWorks />

  <!-- Comunas -->
  <ComunasHighlight />

  <!-- Banner de Cotización -->
  <CotizacionBanner />

  <!-- Galería de trabajos -->
  <Gallery />

  <!-- TEXTO SEO 3: Cierre y CTA (antes del formulario) -->
  <SeoTextBlock variante="texto3" />

  <!-- Formulario de cotización -->
  <QuoteForm />
</BaseLayout>
<!-- cache-bust-v2 -->
