        <div class="group relative aspect-square rounded-xl overflow-hidden border border-neon-500/20 hover:border-neon-500/60 transition-all"><img src="/imagen/drautomotriz/drautomotriz-mecanica-automotriz-diagnostico-reparacion-mantenimiento.webp" alt="Mec├ínica automotriz diagn├│stico y reparaci├│n" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" /><div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-dark-400/90 to-transparent p-2"><span class="text-[9px] text-neon-400 font-semibold">Mec├ínica</span></div></div>
